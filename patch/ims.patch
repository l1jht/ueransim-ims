+std::string ToLower(const std::string &s)
+{
+    std::string out = s;
+    for (auto &c : out)
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return out;
+}
+
+std::string Trim(const std::string &s)
+{
+    size_t begin = 0;
+    size_t end = s.size();
+    while (begin < end && std::isspace(static_cast<unsigned char>(s[begin])))
+        begin++;
+    while (end > begin && std::isspace(static_cast<unsigned char>(s[end - 1])))
+        end--;
+    return s.substr(begin, end - begin);
+}
+
+// Parses "key=value" pairs possibly with quoted values.
+std::vector<std::pair<std::string, std::string>> ParseParameters(const std::string &s)
+{
+    std::vector<std::pair<std::string, std::string>> result;
+    std::string key;
+    std::string value;
+    bool inQuote = false;
+    bool readingKey = true;
+    bool readingValue = false;
+
+    auto flush = [&]()
+    {
+        if (!key.empty())
+            result.emplace_back(Trim(key), Trim(value));
+        key.clear();
+        value.clear();
+        readingKey = true;
+        readingValue = false;
+    };
+
+    for (size_t i = 0; i < s.size(); i++)
+    {
+        char c = s[i];
+        if (c == '"')
+        {
+            inQuote = !inQuote;
+            if (readingKey)
+                readingKey = false;
+            readingValue = true;
+            continue;
+        }
+        if (c == ',' && !inQuote)
+        {
+            flush();
+            continue;
+        }
+        if (c == '=' && !inQuote && !readingValue)
+        {
+            readingKey = false;
+            readingValue = true;
+            continue;
+        }
+        if (readingKey)
+            key.push_back(c);
+        else if (readingValue)
+            value.push_back(c);
+    }
+    flush();
+    return result;
+}
+
+std::string MakeHeader(const std::string &name, const std::string &value)
+{
+    return name + ": " + value + "\r\n";
+}
+
+// Extracts the ";tag=xxx" value from a header (From/To).
+std::string ExtractTag(const std::string &header)
+{
+    auto tagPos = header.rfind(";tag=");
+    if (tagPos == std::string::npos)
+        return {};
+    std::string tag = header.substr(tagPos + 5);
+    tag = Trim(tag);
+    return tag;
+}
+
+// Scans SIP headers (with folding) invoking process(name, value) per header and
+// collecting the message body after the blank line.
+template <typename F>
+void ScanSipHeaders(std::istringstream &stream, F process, std::string &body)
+{
+    std::string line;
+    std::string headerName;
+    std::string headerValue;
+    bool inBody = false;
+    while (std::getline(stream, line))
+    {
+        if (inBody)
+        {
+            body += line + "\n";
+            continue;
+        }
+        if (line == "\r" || line.empty())
+        {
+            if (!headerName.empty())
+                process(headerName, headerValue);
+            headerName.clear();
+            headerValue.clear();
+            inBody = true;
+            continue;
+        }
+        if (!line.empty() && (line[0] == ' ' || line[0] == '\t') && !headerName.empty())
+        {
+            headerValue += " " + Trim(line);
+            continue;
+        }
+        if (!headerName.empty())
+            process(headerName, headerValue);
+        headerName.clear();
+        headerValue.clear();
+
+        auto colon = line.find(':');
+        if (colon != std::string::npos)
+        {
+            headerName = Trim(line.substr(0, colon));
+            headerValue = Trim(line.substr(colon + 1));
+        }
+    }
+    if (!headerName.empty() && !inBody)
+        process(headerName, headerValue);
+}
+
+// The user part of the identity, used in Contact (the identity's domain must not be repeated).
+std::string ContactUser(const ImsConfig &config)
+{
+    std::string user = config.privateIdentity;
+    if (user.rfind("sip:", 0) == 0)
+        user = user.substr(4);
+    auto atPos = user.find('@');
+    if (atPos != std::string::npos)
+        user = user.substr(0, atPos);
+    return user;
+}
+
+// The local Contact header value for this UE.
+std::string ContactHeader(const ImsConfig &config, const std::string &localIp)
+{
+    return "<sip:" + ContactUser(config) + "@" + localIp + ":" + std::to_string(config.sipPort) + ";ob>";
+}
+
+SipAuthChallenge ParseAuthChallenge(const std::string &headerValue)
+{
+    SipAuthChallenge ch{};
+    auto params = ParseParameters(headerValue);
+    for (auto &kv : params)
+    {
+        std::string k = ToLower(kv.first);
+        if (k == "realm")
+            ch.realm = kv.second;
+        else if (k == "nonce")
+            ch.nonce = kv.second;
+        else if (k == "algorithm")
+            ch.algorithm = kv.second;
+        else if (k == "qop")
+        {
+            std::string token;
+            for (char c : kv.second)
+            {
+                if (c == ',' || std::isspace(static_cast<unsigned char>(c)))
+                {
+                    if (!token.empty())
+                    {
+                        ch.qopOptions.push_back(Trim(token));
+                        token.clear();
+                    }
+                }
+                else
+                {
+                    token.push_back(c);
+                }
+            }
+            if (!token.empty())
+                ch.qopOptions.push_back(Trim(token));
+        }
+    }
+    return ch;
+}
+
+} // namespace
+
+std::string RegistrarUri(const ImsConfig &config)
+{
+    std::string registrar = config.registrar;
+    if (registrar.rfind("sip:", 0) != 0)
+        registrar = "sip:" + registrar;
+    return registrar;
+}
+
+std::string BuildRegister(const ImsConfig &config, const std::string &localIp, int cseq, const std::string &callId,
+                          const std::string &branch, const std::string &tag, const std::string &authHeader)
+{
+    std::string registrar = RegistrarUri(config);
+
+    std::string fromTo = config.publicIdentity;
+    if (fromTo.rfind("sip:", 0) != 0 && fromTo.rfind("sips:", 0) != 0)
+        fromTo = "sip:" + fromTo;
+
+    std::string body;
+    body += "REGISTER " + registrar + " SIP/2.0\r\n";
+    body += MakeHeader("Via", "SIP/2.0/UDP " + localIp + ":" + std::to_string(config.sipPort) + ";rport;branch=" + branch);
+    body += MakeHeader("Max-Forwards", "70");
+    body += MakeHeader("From", "<" + fromTo + ">;tag=" + tag);
+    body += MakeHeader("To", "<" + fromTo + ">");
+    body += MakeHeader("Call-ID", callId);
+    body += MakeHeader("CSeq", std::to_string(cseq) + " REGISTER");
+    body += MakeHeader("Contact", ContactHeader(config, localIp));
+    body += MakeHeader("Expires", std::to_string(config.expires));
+    if (!authHeader.empty())
+        body += MakeHeader("Authorization", authHeader);
+    body += "Content-Length: 0\r\n";
+    body += "\r\n";
+    return body;
+}
+
+std::string BuildInvite(const ImsConfig &config, const std::string &localIp, const std::string &remoteUri,
+                        const std::string &serviceRoute, const std::string &callId, const std::string &branch,
+                        const std::string &tag, const std::string &authHeader)
+{
+    std::string fromTo = config.publicIdentity;
+    if (fromTo.rfind("sip:", 0) != 0 && fromTo.rfind("sips:", 0) != 0)
+        fromTo = "sip:" + fromTo;
+
+    std::string sdp = PlaceholderSdp(localIp);
+
+    std::string body;
+    body += "INVITE " + remoteUri + " SIP/2.0\r\n";
+    body += MakeHeader("Via", "SIP/2.0/UDP " + localIp + ":" + std::to_string(config.sipPort) + ";rport;branch=" + branch);
+    body += MakeHeader("Route", "<sip:" + config.pcscf + ":" + std::to_string(config.pcscfPort) + ";lr>");
+    if (!serviceRoute.empty())
+        body += MakeHeader("Route", serviceRoute);
+    body += MakeHeader("Max-Forwards", "70");
+    body += MakeHeader("From", "<" + fromTo + ">;tag=" + tag);
+    body += MakeHeader("To", "<" + remoteUri + ">");
+    body += MakeHeader("Call-ID", callId);
+    body += MakeHeader("CSeq", "1 INVITE");
+    body += MakeHeader("Contact", ContactHeader(config, localIp));
+    if (!authHeader.empty())
+        body += MakeHeader("Authorization", authHeader);
+    body += MakeHeader("Content-Type", "application/sdp");
+    body += MakeHeader("Content-Length", std::to_string(sdp.size()));
+    body += "\r\n";
+    body += sdp;
+    return body;
+}
+
+std::string BuildMessage(const ImsConfig &config, const std::string &localIp, const std::string &remoteUri,
+                         int cseq, const std::string &callId, const std::string &branch, const std::string &tag,
+                         const std::string &text)
+{
+    std::string fromTo = config.publicIdentity;
+    if (fromTo.rfind("sip:", 0) != 0 && fromTo.rfind("sips:", 0) != 0)
+        fromTo = "sip:" + fromTo;
+
+    std::string body;
+    body += "MESSAGE " + remoteUri + " SIP/2.0\r\n";
+    body += MakeHeader("Via", "SIP/2.0/UDP " + localIp + ":" + std::to_string(config.sipPort) + ";rport;branch=" + branch);
+    body += MakeHeader("Route", "<sip:" + config.pcscf + ":" + std::to_string(config.pcscfPort) + ";lr>");
+    body += MakeHeader("Max-Forwards", "70");
+    body += MakeHeader("From", "<" + fromTo + ">;tag=" + tag);
+    body += MakeHeader("To", "<" + remoteUri + ">");
+    body += MakeHeader("Call-ID", callId);
+    body += MakeHeader("CSeq", std::to_string(cseq) + " MESSAGE");
+    body += MakeHeader("Contact", ContactHeader(config, localIp));
+    body += MakeHeader("Content-Type", "text/plain; charset=utf-8");
+    body += MakeHeader("Content-Length", std::to_string(text.size()));
+    body += "\r\n";
+    body += text;
+    return body;
+}
+
+std::string BuildInDialogRequest(const std::string &method, const std::string &localIp, const ImsConfig &config,
+                                 const std::string &remoteUri, const std::string &remoteContact,
+                                 const std::string &routeSet, const std::string &callId, const std::string &branch,
+                                 const std::string &from, const std::string &fromTag, const std::string &to,
+                                 const std::string &toTag, int cseq)
+{
+    // The request target is the remote Contact (URI without the angle brackets), falling back to the dialed URI.
+    std::string target = remoteContact;
+    if (target.rfind('<') != std::string::npos && target.rfind('>') != std::string::npos)
+        target = target.substr(target.find('<') + 1, target.find('>') - target.find('<') - 1);
+    if (target.empty())
+        target = remoteUri;
+
+    std::string body;
+    body += method + " " + target + " SIP/2.0\r\n";
+    body += MakeHeader("Via", "SIP/2.0/UDP " + localIp + ":" + std::to_string(config.sipPort) + ";rport;branch=" + branch);
+    // routeSet is a comma-separated list of Route header values (e.g. "<sip:pcscf;lr>,<sip:orig@...;lr>").
+    std::string token;
+    for (char c : routeSet)
+    {
+        if (c == ',')
+        {
+            if (!token.empty())
+            {
+                body += MakeHeader("Route", Trim(token));
+                token.clear();
+            }
+        }
+        else
+        {
+            token.push_back(c);
+        }
+    }
+    if (!token.empty())
+        body += MakeHeader("Route", Trim(token));
+    body += MakeHeader("Max-Forwards", "70");
+    body += MakeHeader("From", "<" + from + ">;tag=" + fromTag);
+    body += MakeHeader("To", "<" + to + ">" + (toTag.empty() ? std::string{} : std::string{";tag=" + toTag}));
+    body += MakeHeader("Call-ID", callId);
+    body += MakeHeader("CSeq", std::to_string(cseq) + " " + method);
+    body += MakeHeader("Contact", ContactHeader(config, localIp));
+    body += "Content-Length: 0\r\n";
+    body += "\r\n";
+    return body;
+}
+
+std::string BuildErrorAck(const ImsConfig &config, const std::string &localIp, const std::string &remoteUri,
+                          const std::string &callId, const std::string &fromTag, int cseq)
+{
+    // ACK for a non-2xx final response to an INVITE (RFC 3261 17.1.1.3): request-URI is the
+    // INVITE request-URI, no Route/Contact, same Call-ID/branch semantics as the failed transaction.
+    std::string body;
+    body += "ACK " + remoteUri + " SIP/2.0\r\n";
+    body += MakeHeader("Via", "SIP/2.0/UDP " + localIp + ":" + std::to_string(config.sipPort) +
+                               ";rport;branch=z9hG4bK" + std::to_string(cseq));
+    body += MakeHeader("Max-Forwards", "70");
+    body += MakeHeader("From", "<" + config.publicIdentity + ">;tag=" + fromTag);
+    body += MakeHeader("To", "<" + remoteUri + ">");
+    body += MakeHeader("Call-ID", callId);
+    body += MakeHeader("CSeq", std::to_string(cseq) + " ACK");
+    body += "Content-Length: 0\r\n";
+    body += "\r\n";
+    return body;
+}
+
+std::string BuildSipReply(const ImsConfig &config, const std::string &localIp, int statusCode,
+                          const std::string &reasonPhrase, const SipRequestInfo &req, const std::string &toTag,
+                          const std::string &body)
+{
+    std::string out;
+    out += "SIP/2.0 " + std::to_string(statusCode) + " " + reasonPhrase + "\r\n";
+    if (!req.viaAll.empty())
+        out += req.viaAll + "\r\n";
+    else if (!req.via.empty())
+        out += MakeHeader("Via", req.via);
+    // 2xx (and 18x) responses must echo the Record-Route set (RFC 3261 12.1.1): the caller
+    // builds its in-dialog route set from it.
+    if (!req.recordRoutes.empty())
+    {
+        for (const auto &rr : req.recordRoutes)
+            out += MakeHeader("Record-Route", rr);
+    }
+    if (!req.from.empty())
+        out += MakeHeader("From", req.from);
+    out += MakeHeader("To", req.to + (toTag.empty() ? std::string{} : std::string{";tag=" + toTag}));
+    if (!req.callId.empty())
+        out += MakeHeader("Call-ID", req.callId);
+    out += MakeHeader("CSeq", std::to_string(req.cseq) + " " + req.cseqMethod);
+    out += MakeHeader("Contact", ContactHeader(config, localIp));
+    if (!body.empty())
+    {
+        out += MakeHeader("Content-Type", "application/sdp");
+        out += MakeHeader("Content-Length", std::to_string(body.size()));
+        out += "\r\n";
+        out += body;
+    }
+    else
+    {
+        out += "Content-Length: 0\r\n";
+        out += "\r\n";
+    }
+    return out;
+}
+
+std::string PlaceholderSdp(const std::string &localIp)
+{
+    // P2 kept a fixed port so rtpengine would accept the offer; P3 makes it configurable.
+    return BuildMediaSdp(localIp, 49170);
+}
+
+std::string BuildMediaSdp(const std::string &localIp, int mediaPort)
+{
+    return "v=0\r\no=- 0 0 IN IP4 " + localIp + "\r\ns=-\r\nc=IN IP4 " + localIp + "\r\nt=0 0\r\nm=audio " +
+           std::to_string(mediaPort) + " RTP/AVP 0\r\na=rtpmap:0 PCMU/8000\r\na=sendrecv\r\n";
+}
+
+bool ParseSdpMedia(const std::string &sdp, std::string &outAddress, int &outPort)
+{
+    std::istringstream stream(sdp);
+    std::string line;
+    bool haveAddress = false;
+    while (std::getline(stream, line))
+    {
+        line = Trim(line);
+        if (line.rfind("c=", 0) == 0 && !haveAddress)
+        {
+            // c=IN IP4 <addr>
+            auto parts = line.substr(2);
+            auto sp = parts.rfind(' ');
+            if (sp != std::string::npos)
+            {
+                outAddress = Trim(parts.substr(sp + 1));
+                haveAddress = true;
+            }
+        }
+        else if (line.rfind("m=audio ", 0) == 0)
+        {
+            // m=audio <port> RTP/AVP ...
+            auto rest = Trim(line.substr(8));
+            auto sp = rest.find(' ');
+            auto portStr = sp == std::string::npos ? rest : rest.substr(0, sp);
+            outPort = std::atoi(portStr.c_str());
+            if (outPort > 0 && haveAddress)
+                return true;
+        }
+    }
+    return haveAddress && outPort > 0;
+}
+
+SipResponseInfo ParseSipResponse(const std::string &text)
+{
+    SipResponseInfo info;
+    std::istringstream stream(text);
+    std::string line;
+
+    if (!std::getline(stream, line))
+        return info;
+    line = Trim(line);
+    if (line.rfind("SIP/2.0 ", 0) == 0)
+    {
+        auto space1 = line.find(' ');
+        auto space2 = line.find(' ', space1 + 1);
+        if (space1 != std::string::npos && space2 != std::string::npos)
+        {
+            std::string code = line.substr(space1 + 1, space2 - space1 - 1);
+            info.statusCode = std::atoi(code.c_str());
+            info.reasonPhrase = line.substr(space2 + 1);
+        }
+    }
+    else
+    {
+        return info;
+    }
+
+    auto processHeader = [&info](const std::string &name, const std::string &value)
+    {
+        std::string lname = ToLower(name);
+        if (lname == "call-id")
+            info.callId = Trim(value);
+        else if (lname == "expires")
+            info.expires = std::atoi(Trim(value).c_str());
+        else if (lname == "www-authenticate")
+            info.challenge = ParseAuthChallenge(value);
+        else if (lname == "service-route")
+            info.serviceRoutes.push_back(Trim(value));
+        else if (lname == "to")
+        {
+            auto val = Trim(value);
+            info.toTag = ExtractTag(val);
+        }
+        else if (lname == "contact")
+            info.contact = Trim(value);
+        else if (lname == "record-route")
+            info.recordRoutes.push_back(Trim(value));
+        else if (lname == "cseq")
+        {
+            auto cseq = Trim(value);
+            auto sp = cseq.find(' ');
+            if (sp != std::string::npos)
+                info.cseq = std::atoi(cseq.substr(0, sp).c_str());
+            else
+                info.cseq = std::atoi(cseq.c_str());
+        }
+    };
+    std::string body;
+    ScanSipHeaders(stream, processHeader, body);
+
+    while (!body.empty() && body.back() == '\n')
+        body.pop_back();
+    info.body = body;
+
+    return info;
+}
+
+SipRequestInfo ParseSipRequest(const std::string &text)
+{
+    SipRequestInfo info;
+    std::istringstream stream(text);
+    std::string line;
+
+    if (!std::getline(stream, line))
+        return info;
+    line = Trim(line);
+    auto space1 = line.find(' ');
+    auto space2 = line.find(' ', space1 + 1);
+    if (space1 == std::string::npos || space2 == std::string::npos)
+        return info;
+    info.method = line.substr(0, space1);
+    info.requestUri = line.substr(space1 + 1, space2 - space1 - 1);
+
+    std::string body;
+    auto process = [&info](const std::string &name, const std::string &value)
+    {
+        std::string lname = ToLower(name);
+        if (lname == "via")
+        {
+            // UAS replies must echo the full Via chain so each proxy can strip its own
+            // Via and forward the reply upstream; keep every header occurrence.
+            if (info.via.empty())
+                info.via = Trim(value);
+            info.viaAll += (info.viaAll.empty() ? std::string{} : std::string{"\r\n"}) + "Via: " + Trim(value);
+        }
+        else if (lname == "from")
+        {
+            auto val = Trim(value);
+            info.from = val;
+            info.fromTag = ExtractTag(val);
+        }
+        else if (lname == "to")
+        {
+            auto val = Trim(value);
+            info.to = val;
+            info.toTag = ExtractTag(val);
+        }
+        else if (lname == "call-id")
+            info.callId = Trim(value);
+        else if (lname == "cseq")
+        {
+            auto cseq = Trim(value);
+            auto sp = cseq.find(' ');
+            if (sp != std::string::npos)
+            {
+                info.cseq = std::atoi(cseq.substr(0, sp).c_str());
+                info.cseqMethod = Trim(cseq.substr(sp + 1));
+            }
+        }
+        else if (lname == "contact")
+            info.contact = Trim(value);
+        else if (lname == "record-route")
+            info.recordRoutes.push_back(Trim(value));
+    };
+    ScanSipHeaders(stream, process, body);
+
+    // Normalize the body: strip the trailing \n -> we join with \n above.
+    while (!body.empty() && body.back() == '\n')
+        body.pop_back();
+    info.body = body;
+    return info;
+}
+
+
+} // namespace ims
+} // namespace nr::ue
