+// Parse the response=... value out of an Authorization header.
+std::string ExtractResponseValue(const std::string &header)
+{
+    auto pos = header.find("response=\"");
+    if (pos == std::string::npos)
+        return {};
+    auto start = pos + 10;
+    auto end = header.find('"', start);
+    if (end == std::string::npos)
+        return {};
+    return header.substr(start, end - start);
+}
+
+std::string ExtractParam(const std::string &header, const std::string &name)
+{
+    auto pos = header.find(name + "=\"");
+    if (pos == std::string::npos)
+        return {};
+    auto start = pos + name.size() + 2;
+    auto end = header.find('"', start);
+    if (end == std::string::npos)
+        return {};
+    return header.substr(start, end - start);
+}
