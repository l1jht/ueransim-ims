+#include <ue/ims/media.hpp>
+#include <ue/ims/packet.hpp>
+#include <ue/nas/task.hpp>
+#include <ue/nts.hpp>
+#include <utils/common.hpp>
+
+namespace nr::ue::ims
+{
+
+RtpSender::RtpSender(TaskBase *base) : m_base{base}
+{
+}
+
+void RtpSender::Start(int psi, const std::string &localIp, int localPort, const std::string &peerIp, int peerPort,
+                      uint32_t ssrc)
+{
+    m_psi = psi;
+    m_localIp = localIp;
+    m_localPort = localPort;
+    m_peerIp = peerIp;
+    m_peerPort = peerPort;
+    m_ssrc = static_cast<int>(ssrc);
+    m_seq = 0;
+    m_ts = 0;
+    m_txCount = 0;
+}
+
+void RtpSender::Stop()
+{
+    m_peerPort = 0;
+    m_localPort = 0;
+}
+
+void RtpSender::Send()
+{
+    if (!IsRunning())
+        return;
+
+    OctetString packet = BuildRtpPacket(m_localIp, m_localPort, m_peerIp, m_peerPort,
+                                        static_cast<uint32_t>(m_ssrc), m_seq, m_ts);
+    auto m = std::make_unique<NmUeAppToNas>(NmUeAppToNas::UPLINK_DATA_DELIVERY);
+    m->psi = m_psi;
+    m->data = std::move(packet);
+    m_base->nasTask->push(std::move(m));
+
+    m_seq++;
+    m_ts += 160; // 20 ms at 8 kHz
+    m_txCount++;
+}
+
+bool RtpSender::IsRunning() const
+{
+    return m_localPort > 0 && m_peerPort > 0;
+}
+
+uint64_t RtpSender::TxCount() const
+{
+    return m_txCount;
+}
+
+} // namespace nr::ue::ims
