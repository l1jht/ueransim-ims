+                        const std::string &serviceRoute, const std::string &callId, const std::string &branch,
+                        const std::string &tag, const std::string &authHeader);
+
+// Builds an out-of-dialog MESSAGE request (SMS over IMS, RFC 3428): single transaction, no dialog state.
