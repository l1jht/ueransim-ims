+void TestTransactionTable()
+{
+    using ims::SipTransactionTable;
+
+    // 1) arm -> tick retransmits 4 times at the caller's cadence, then the entry expires.
+    {
+        SipTransactionTable t;
+        CHECK_EQ((int)t.arm("call@a", 1, "INVITE-1"), (int)ims::EArmResult::ADDED);
+        for (int i = 0; i < 4; i++)
+        {
+            auto out = t.tick();
+            CHECK_EQ(out.size(), (size_t)1);
+            CHECK_EQ(out[0], std::string("INVITE-1"));
+        }
+        CHECK(t.tick().empty());
+        CHECK(t.empty());
+    }
+
+    // 2) cancel removes exactly the matching (Call-ID, CSeq) entry, sparing the rest.
+    {
+        SipTransactionTable t;
+        t.arm("call@a", 1, "INVITE-1");
+        t.arm("call@a", 2, "BYE-2");
+        t.arm("sms@a", 5, "MSG-5");
+        CHECK(t.cancel("call@a", 1));
+        CHECK(!t.contains("call@a", 1));
+        CHECK(t.contains("call@a", 2));
+        CHECK(t.contains("sms@a", 5));
+        CHECK(!t.cancel("call@a", 99));
+        CHECK_EQ(t.size(), (size_t)2);
+    }
+
+    // 3) cancelAll clears everything.
+    {
+        SipTransactionTable t;
+        t.arm("a", 1, "x");
+        t.arm("b", 1, "y");
+        t.cancelAll();
+        CHECK(t.empty());
+        CHECK(t.tick().empty());
+    }
+
+    // 4) capacity 8: the 9th arm evicts the oldest entry.
+    {
+        SipTransactionTable t;
+        for (int i = 0; i < 8; i++)
+            CHECK_EQ((int)t.arm("call", i, "body-" + std::to_string(i)), (int)ims::EArmResult::ADDED);
+        CHECK_EQ((int)t.arm("call", 8, "body-8"), (int)ims::EArmResult::ADDED_WITH_EVICTION);
+        CHECK_EQ(t.size(), SipTransactionTable::CAPACITY);
+        CHECK(!t.contains("call", 0));
+        CHECK(t.contains("call", 1));
+        CHECK(t.contains("call", 8));
+    }
+
+    // 5) re-arming the same key replaces (no duplicate entries, counter reset).
+    {
+        SipTransactionTable t;
+        t.arm("call@a", 1, "plain");
+        CHECK_EQ((int)t.arm("call@a", 1, "auth"), (int)ims::EArmResult::REPLACED);
+        CHECK_EQ(t.size(), (size_t)1);
+        auto out = t.tick();
+        CHECK_EQ(out.size(), (size_t)1);
+        CHECK_EQ(out[0], std::string("auth"));
+    }
+
+    // 6) tick on an empty table is a no-op.
+    {
+        SipTransactionTable t;
+        CHECK(t.tick().empty());
+        CHECK(t.empty());
+    }
+
+    // 7) Regression for the single-slot defect: INVITE and SMS armed together must BOTH
+    //    be retransmitted on tick (the old single slot let the second arm overwrite the first).
+    {
+        SipTransactionTable t;
+        t.arm("call@a", 1, "INVITE-1");
+        t.arm("sms@a", 3, "MSG-3");
+        auto out = t.tick();
+        CHECK_EQ(out.size(), (size_t)2);
+        CHECK(std::find(out.begin(), out.end(), std::string("INVITE-1")) != out.end());
+        CHECK(std::find(out.begin(), out.end(), std::string("MSG-3")) != out.end());
+        CHECK(t.contains("call@a", 1));
+        CHECK(t.contains("sms@a", 3));
+    }
+}
+
+int main()
+{
+    TestMd5Vectors();
+    TestPacketChecksums();
+    TestUdpDetection();
+    TestRtpPacket();
+    TestSdpMedia();
+    TestRfc3310Password();
+    TestAkaChallenge();
+    TestSipRoundTrip();
+    TestDigestResponse();
+    TestDigestAuth();
+    TestTransactionTable();
+
+    if (g_failures == 0)
+    {
+        std::printf("ims-tests: all passed\n");
+        return 0;
+    }
+    std::fprintf(stderr, "ims-tests: %d failure(s)\n", g_failures);
+    return 1;
+}
