+bool DigestAuth::beginChallenge(const SipAuthChallenge &challenge, const std::string &fallbackRealm)
+{
+    if (challenge.nonce.empty())
+        return false;
+    if (!challenge.qopOptions.empty())
+    {
+        bool hasAuth = false;
+        for (auto &opt : challenge.qopOptions)
+        {
+            if (opt == "auth")
+            {
+                hasAuth = true;
+                break;
+            }
+        }
+        if (!hasAuth)
+            return false;
+    }
+
+    m_nonce = challenge.nonce;
+    m_realm = challenge.realm.empty() ? fallbackRealm : challenge.realm;
+    m_cnonce = GenerateId();
+    m_nc = 0;
+    m_hasChallenge = true;
+
+    // IMS AKA (RFC 3310): nonce carries RAND||AUTN; the digest password is derived from IK/CK.
+    m_aka = challenge.algorithm == "AKAv1-MD5";
+    m_akaReady = false;
+    if (m_aka)
+    {
+        if (m_opcHex.length() != 32 || !ParseAkaNonce(m_nonce, m_rand, m_autn))
+            return false; // unusable AKA challenge
+        m_akaReady = true;
+    }
+    return true;
+}
+
+bool DigestAuth::validateAutn() 
+{
+    if (!m_akaReady)
+        return false;
+
+    // AUTN = SQN||AMF||MAC-A (6+2+8 bytes). AK = f5(K, RAND), independent of SQN.
+    static const OctetString zero6{OctetString::FromHex("000000000000")};
+    static const OctetString zero2{OctetString::FromHex("0000")};
+    OctetString opc = OctetString::FromHex(m_opcHex);
+    auto m0 = crypto::milenage::Calculate(opc, OctetString::FromHex(m_password), m_rand, zero6, zero2);
+    OctetString sqn = OctetString::Xor(m_autn.subCopy(0, 6), m0.ak);
+    OctetString amf = m_autn.subCopy(6, 2);
+    auto m = crypto::milenage::Calculate(opc, OctetString::FromHex(m_password), m_rand, sqn, amf);
+
+    // Separation bit (AMF MSB, 3GPP 33.102) must be set.
+    if (amf.length() > 0 && (amf.get(0).bit(7) != 1))
+        return false;
+
+    // MAC-A check.
+    if (m.mac_a != m_autn.subCopy(8, 8))
+        return false;
+
+    // The deployed S-CSCF (kamailio ims_auth) verifies AKA digests against the XRES raw
+    // bytes used as the digest password — not hex, not the RFC 3310 IK/CK-derived RK.
+    // Empirically matched (python-verified) against the test S-CSCF.
+    m_rkPassword.assign(reinterpret_cast<const char *>(m.res.data()), m.res.length());
+    return true;
+}
+
+std::string DigestAuth::authorization(const std::string &method, const std::string &uri)
+{
+    if (!m_hasChallenge)
+        return {};
+
+    std::string nc = nextNonceCount();
+    std::string algo = "MD5";
+    std::string pass = m_password;
+    if (m_aka)
+    {
+        if (!m_akaReady || !validateAutn())
+            return {};
+        algo = "AKAv1-MD5";
+        pass = m_rkPassword;
+    }
+
+    std::string response = DigestResponse(m_username, m_realm, pass, m_nonce, nc, m_cnonce, "auth", method, uri);
+
+    return "Digest username=\"" + m_username + "\", realm=\"" + m_realm + "\", nonce=\"" + m_nonce +
+           "\", uri=\"" + uri + "\", response=\"" + response + "\", algorithm=" + algo + ", cnonce=\"" + m_cnonce +
+           "\", nc=" + nc + ", qop=auth";
+}
+
+bool DigestAuth::hasChallenge() const
+{
+    return m_hasChallenge;
+}
+
+bool DigestAuth::isAka() const
+{
+    return m_aka;
+}
+
+void DigestAuth::reset()
+{
+    m_nonce.clear();
+    m_realm.clear();
+    m_cnonce.clear();
+    m_nc = 0;
+    m_hasChallenge = false;
+    m_aka = false;
+    m_akaReady = false;
+}
+
+std::string DigestAuth::nextNonceCount()
+{
+    m_nc++;
+    static const char *hex = "0123456789abcdef";
+    std::string out;
+    out.reserve(8);
+    uint32_t v = static_cast<uint32_t>(m_nc);
+    for (int i = 6; i >= 0; i -= 2)
+    {
+        out.push_back(hex[(v >> (i + 4)) & 0xF]);
+        out.push_back(hex[(v >> i) & 0xF]);
+    }
+    return out;
+}
+
+std::string DeriveRfc3310Password(const OctetString &ik, const OctetString &ck)
+{
+    // RFC 3310 6.1: password = MD5(hex(ik) + ":" + hex(ck)) with lower-case hex.
+    auto toLowerHex = [](const OctetString &v) {
+        std::string h = v.toHexString();
+        for (auto &c : h)
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        return h;
+    };
+    std::string input = toLowerHex(ik) + ":" + toLowerHex(ck);
+    return Md5Hex(input);
+}
+
+} // namespace ims
+} // namespace nr::ue
