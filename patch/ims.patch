+
+// Stateful Digest access authentication (RFC 2617, qop=auth) with 3GPP IMS AKA
+// (Digest-AKAv1-MD5, RFC 3310) support. Holds one challenge's state (nonce/realm/cnonce/nc)
+// and produces the Authorization header value.
+class DigestAuth
+{
+  public:
+    DigestAuth(std::string username, std::string password);
+
+    // Installs the AKA credentials (OPc and AMF); enables AKAv1-MD5 challenge handling.
+    void setAkaCredentials(const OctetString &opc, const OctetString &amf);
+
+    // Adopts a 401 challenge. Returns false if the challenge is unusable (missing nonce,
+    // or a non-empty qop list without "auth"). On success the nc counter resets and a fresh
+    // cnonce is generated. For algorithm=AKAv1-MD5 the nonce must be RAND||AUTN (64 hex).
+    bool beginChallenge(const SipAuthChallenge &challenge, const std::string &fallbackRealm);
+
+    // Builds the full Authorization header value for the given method/uri. Empty string if
+    // no usable challenge has been adopted.
+    std::string authorization(const std::string &method, const std::string &uri);
+
+    bool hasChallenge() const;
+
+    // Returns true when the adopted challenge is AKA (AKAv1-MD5).
+    bool isAka() const;
+
+    // Validates AUTN (SEP bit + MAC). Returns true on success. Only meaningful after beginChallenge.
+    bool validateAutn();
+
+    void reset();
+
+  private:
+    std::string nextNonceCount();
+
+    std::string m_username;
+    std::string m_password; // Ki (MD5 mode) or RK-derived password (AKA mode, computed per challenge)
+    std::string m_nonce;
+    std::string m_realm;
+    std::string m_cnonce;
+    int m_nc{0};
+    bool m_hasChallenge{false};
+
+    // AKA state
+    bool m_aka{false};
+    bool m_akaReady{false};
+    std::string m_opcHex;
+    std::string m_amfHex;
+    OctetString m_rand;
+    OctetString m_autn;
+    std::string m_rkPassword; // RFC 3310 derived password
+};
+
+// RFC 3310: password = MD5(hex(ik) + ":" + hex(ck)) (lower-case hex, colon-separated).
+std::string DeriveRfc3310Password(const OctetString &ik, const OctetString &ck);
+
