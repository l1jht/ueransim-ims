+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+#pragma once
+
+#include <string>
+#include <deque>
+#include <utility>
+
+#include <ue/nts.hpp>
+#include <ue/types.hpp>
+#include <utils/logger.hpp>
+#include <utils/nts.hpp>
+
+#include "auth.hpp"
+#include "media.hpp"
+#include "sip_stack.hpp"
+#include "transaction.hpp"
+
+namespace nr::ue
+{
+
+class ImsClientTask : public NtsTask
+{
+  private:
+    enum class ERegState
+    {
+        IDLE,
+        REGISTERING,
+        REGISTERED,
+        FAILED,
+    };
+
+    enum class ECallState
+    {
+        IDLE,
+        CALLING,   // caller: INVITE sent, awaiting final response
+        RINGING,   // callee: INVITE received (auto-answer pending)
+        ANSWERING, // callee: 200 sent, awaiting ACK
+        CONFIRMED, // dialog established
+        HANGING_UP // BYE sent, awaiting 200
+    };
+
+    static constexpr const int TIMER_REG_TIMEOUT = 1;
+    static constexpr const int TIMER_REG_RETRY = 2;
+    static constexpr const int TIMER_RE_REGISTER = 3;
+    static constexpr const int TIMER_TX_RETRANSMIT = 4;
+    static constexpr const int TIMER_CALL_TIMEOUT = 5;
+    static constexpr const int TIMER_MEDIA_SEND = 6;
+    static constexpr const int TIMER_2XX_RETRANSMIT = 7;
+
+    static constexpr const int REG_ATTEMPT_TIMEOUT_MS = 3000;
+    static constexpr const int TX_RETRANSMIT_MS = 500;
+    static constexpr const int CALL_TIMEOUT_MS = 15000;
+    static constexpr const int MEDIA_SEND_MS = 20;
+
+  private:
+    TaskBase *m_base;
+    std::unique_ptr<Logger> m_logger;
+
+    // Session binding (apn == "ims")
+    bool m_bound{false};
+    int m_psi{-1};
+    std::string m_localIp;
+    std::string m_pcscfIp;
+
+    // Registration state
+    ERegState m_regState{ERegState::IDLE};
+    int m_cseq{0};
+    std::string m_regCallId;
+    std::string m_regBranch;
+    std::string m_regTag;
+    bool m_usingAuth{false};
+    int m_authRetryCount{0};  // 401 re-challenge attempts used within one registration flow
+    int m_regExpires{300};
+    std::string m_serviceRoute;
+    uint32_t m_retryIndex{0};
+    std::string m_lastError;
+    int m_lastRegCseq{0};
+    int64_t m_regSuccessTime{0};
+
+    // Call state
+    ECallState m_callState{ECallState::IDLE};
+    std::string m_callCallId;
+    std::string m_callBranch;
+    std::string m_dialogMyTag;
+    std::string m_remoteUri;
+    std::string m_remoteContact;
+    std::string m_dialogPeerTag;
+    std::string m_callRouteSet;
+    int m_callCSeq{0};
+    int m_lastReplyCode{0};
+    std::string m_lastReplyReason;
+    std::string m_lastReplyBody;
+    bool m_2xxRetransmitActive{false};  // RFC 3261 17.2.1 Timer G: retransmit 2xx until ACK
+    bool m_callUsingAuth{false};
+    ims::SipTransactionTable m_txTable;
+    ims::SipRequestInfo m_pendingInvite;
+    // SMS over IMS (SIP MESSAGE, RFC 3428): single transaction, no dialog state.
+    int m_smsCSeq{0};
+    std::string m_smsCallId;
+    std::string m_lastSmsResult;
+    std::deque<std::pair<std::string, std::string>> m_smsHistory{};  // recent (peer, text) up to 10
+
+    // Digest challenges (registration vs call keep independent state; each is one DigestAuth).
+    ims::DigestAuth m_regAuth;
+    ims::DigestAuth m_callAuth;
+
+    // Media (P3): best-effort PCMU silence sender + receive counter.
+    ims::RtpSender m_media;
+    uint64_t m_mediaRxCount{0};
+    uint32_t m_mediaSsrc{0};
+
+    // Pseudo-random generator counter
+    uint64_t m_rngCounter{0};
+
+  public:
+    explicit ImsClientTask(TaskBase *base);
+
+  protected:
+    void onStart() override;
+    void onLoop() override;
+    void onQuit() override;
+
+  private:
+    void handleMessage(NtsMessage &msg);
+    void handleSessionBound(const NmUeAppToIms &msg);
+    void handleSessionReleased(const NmUeAppToIms &msg);
+    void handleDownlinkData(const NmUeAppToIms &msg);
+    void handleCliCommand(const NmUeAppToIms &msg);
+    void handleTimer(const NmTimerExpired &msg);
+
+    void startRegistration();
+    void sendRegister(bool withAuth);
+    void handleSipResponse(const std::string &text);
+    void onRegFail(const std::string &reason);
+    void onRegSuccess(int expires);
+    void scheduleRetry();
+    void scheduleReRegister();
+    void armAttemptTimeout();
+
+    void startCall(const std::string &uri);
+    void sendInvite(bool withAuth);
+    void sendAck();
+    void sendErrorAck();
+    void sendSms(const std::string &uri, const std::string &text);
+    void handleIncomingSms(const ims::SipRequestInfo &req);
+    void startMedia(const std::string &peerIp, int peerPort);
+    void stopMedia();
+    void sendBye();
+    void hangupCall();
+    void handleCallResponse(const ims::SipResponseInfo &info);
+    void handleCallRequest(const ims::SipRequestInfo &req);
+    void sendCallReply(const ims::SipRequestInfo &req, int code, const std::string &reason, const std::string &body);
+    void callFail(const std::string &reason);
+    void armTx(const std::string &callId, int cseq, const std::string &body);
+
+    void sendResponse(const InetAddress &address, const std::string &output, bool isError);
+    void sendSipUdp(const std::string &body);
+    std::string generateId();
+    std::string statusText();
+    std::string smsHistoryText();
+    std::string regStateName() const;
+    std::string callStateName() const;
+};
+
+} // namespace nr::ue
