+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+namespace nr::ue
+{
+namespace ims
+{
+
+struct SipTransaction
+{
+    std::string callId;
+    int cseq{0};
+    std::string body;
+    int retransmitsLeft{0};
+};
+
+enum class EArmResult
+{
+    ADDED,
+    REPLACED,
+    ADDED_WITH_EVICTION,
+};
+
+// Retransmission lifecycle of pending SIP client transactions (INVITE/BYE/MESSAGE),
+// keyed by Call-ID + CSeq. Pure logic: tick() returns the bodies to send, the caller
+// owns transport and the 500 ms cadence.
+class SipTransactionTable
+{
+  public:
+    static constexpr const int MAX_RETRANSMITS = 4;
+    static constexpr const std::size_t CAPACITY = 8;
+
+    EArmResult arm(const std::string &callId, int cseq, const std::string &body);
+    bool cancel(const std::string &callId, int cseq);
+    void cancelAll();
+    std::vector<std::string> tick();
+    bool contains(const std::string &callId, int cseq) const;
+    bool empty() const;
+    std::size_t size() const;
+
+  private:
+    std::vector<SipTransaction> m_entries{};
+};
+
+} // namespace ims
+} // namespace nr::ue
