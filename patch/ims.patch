+                         int cseq, const std::string &callId, const std::string &branch, const std::string &tag,
+                         const std::string &text);
+
+// Builds an in-dialog request (ACK/BYE). routeSet is the list of Route header values.
+std::string BuildInDialogRequest(const std::string &method, const std::string &localIp, const ImsConfig &config,
+                                 const std::string &remoteUri, const std::string &remoteContact,
+                                 const std::string &routeSet, const std::string &callId, const std::string &branch,
+                                 const std::string &from, const std::string &fromTag, const std::string &to,
+                                 const std::string &toTag, int cseq);
+
+// Builds an ACK for a non-2xx final response to an INVITE (RFC 3261 17.1.1.3): no Route/Contact.
