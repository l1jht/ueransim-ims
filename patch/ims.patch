+void TestDigestAuth()
+{
+    DigestAuth auth("001011234567895@ims.mnc001.mcc001.3gppnetwork.org", "8baf473f2f8fd09487cccbd7097c6862");
+
+    // no challenge yet -> no header
+    CHECK(!auth.hasChallenge());
+    CHECK(auth.authorization("REGISTER", "sip:ims").empty());
+
+    // unusable challenge (no nonce) -> rejected
+    SipAuthChallenge bad{};
+    bad.nonce = "";
+    CHECK(!auth.beginChallenge(bad, "fallback"));
+    CHECK(!auth.hasChallenge());
+
+    // qop list without auth -> rejected
+    SipAuthChallenge noQopAuth{};
+    noQopAuth.nonce = "n1";
+    noQopAuth.qopOptions = {"auth-int"};
+    CHECK(!auth.beginChallenge(noQopAuth, "fallback"));
+
+    // usable challenge
+    SipAuthChallenge ch{};
+    ch.nonce = "dcd98b7102dd2f0e8b11d0f600bfb0c093";
+    ch.realm = "testrealm@host.com";
+    ch.qopOptions = {"auth", "auth-int"};
+    CHECK(auth.beginChallenge(ch, "unused-fallback"));
+    CHECK(auth.hasChallenge());
+
+    // header structure + nc starts at 00000001
+    std::string h1 = auth.authorization("REGISTER", "sip:reg");
+    CHECK(h1.rfind("Digest username=\"001011234567895@ims.mnc001.mcc001.3gppnetwork.org\"", 0) == 0);
+    CHECK(ExtractParam(h1, "realm") == "testrealm@host.com");
+    CHECK(ExtractParam(h1, "nonce") == "dcd98b7102dd2f0e8b11d0f600bfb0c093");
+    CHECK(h1.find("nc=00000001") != std::string::npos);
+    CHECK(h1.find("qop=auth") != std::string::npos);
+    CHECK(ExtractResponseValue(h1).size() == 32);
+
+    // response is consistent with the pure DigestResponse given the header's own parameters
+    auto cnonce = ExtractParam(h1, "cnonce");
+    auto r1 = ExtractResponseValue(h1);
+    CHECK_EQ(r1, DigestResponse("001011234567895@ims.mnc001.mcc001.3gppnetwork.org", "testrealm@host.com",
+                                "8baf473f2f8fd09487cccbd7097c6862", "dcd98b7102dd2f0e8b11d0f600bfb0c093",
+                                "00000001", cnonce, "auth", "REGISTER", "sip:reg"));
+
+    // nc increments on the next call
+    std::string h2 = auth.authorization("REGISTER", "sip:reg");
+    CHECK(h2.find("nc=00000002") != std::string::npos);
+    CHECK(ExtractResponseValue(h2) != ExtractResponseValue(h1));
+
+    // Re-challenge (401 on authenticated REGISTER -> server sends a fresh nonce):
+    // beginChallenge must cleanly adopt the new challenge, reset nc, and use the new nonce.
+    SipAuthChallenge ch2{};
+    ch2.nonce = "new-nonce-2nd-challenge";
+    ch2.realm = "testrealm@host.com";
+    ch2.qopOptions = {"auth"};
+    CHECK(auth.beginChallenge(ch2, "unused-fallback"));
+    std::string h3 = auth.authorization("REGISTER", "sip:reg");
+    CHECK(ExtractParam(h3, "nonce") == "new-nonce-2nd-challenge");
+    CHECK(h3.find("nc=00000001") != std::string::npos);
+    CHECK(h3.find("qop=auth") != std::string::npos);
+    CHECK(ExtractResponseValue(h3) != ExtractResponseValue(h2));
+
+    // reset clears the challenge
+    auth.reset();
+    CHECK(!auth.hasChallenge());
+    CHECK(auth.authorization("REGISTER", "sip:reg").empty());
+}
