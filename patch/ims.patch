+void TestRtpPacket()
+{
+    // P3 media: one PCMU silence frame packet = IPv4/UDP header + 12B RTP header + 160B payload.
+    auto pkt = BuildRtpPacket("192.168.101.3", 50000, "172.21.0.16", 49170, 0xDEADBEEF, 0x1234, 0x01020304);
+    CHECK_EQ(pkt.length(), 28 + 12 + 160);
+    // UDP payload = RTP packet body
+    std::string body = ExtractUdpPayload(pkt);
+    CHECK_EQ(body.size(), 172u);
+    // RTP header: V=2, no padding/extension, PT=0 (PCMU)
+    CHECK_EQ(static_cast<uint8_t>(body[0]), 0x80u);
+    CHECK_EQ(static_cast<uint8_t>(body[1]), 0x00u);
+    // seq and timestamp round trip
+    CHECK_EQ(static_cast<uint8_t>(body[2]), 0x12u);
+    CHECK_EQ(static_cast<uint8_t>(body[3]), 0x34u);
+    CHECK_EQ(static_cast<uint8_t>(body[4]), 0x01u);
+    CHECK_EQ(static_cast<uint8_t>(body[7]), 0x04u);
+    // SSRC round trip
+    CHECK_EQ(static_cast<uint8_t>(body[8]), 0xDEu);
+    CHECK_EQ(static_cast<uint8_t>(body[11]), 0xEFu);
+    // silence payload present (160 bytes) and header checksum valid
+    CHECK_EQ(body[171], static_cast<char>(0xFF));
+    uint8_t ipHdr[20];
+    std::memcpy(ipHdr, pkt.data(), 20);
+    ipHdr[10] = 0;
+    ipHdr[11] = 0;
+    uint16_t refIp = RefChecksum(ipHdr, 20);
+    uint16_t ip = (pkt.data()[10] << 8) | pkt.data()[11];
+    CHECK_EQ(ip, refIp);
+    // UDP checksum matches the reference
+    uint16_t refUdp = RefUdpChecksum(pkt);
+    uint16_t udp = (pkt.data()[26] << 8) | pkt.data()[27];
+    CHECK_EQ(udp, refUdp);
+}
