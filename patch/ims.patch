+std::string GenerateId()
+{
+    static std::atomic<uint64_t> counter{0};
+    auto now =
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+    return std::to_string(now) + "-" + std::to_string(counter.fetch_add(1));
+}
+
+// Parses "RAND||AUTN" from an AKAv1 nonce. kamailio/pyHSS deliver the 32-byte pair either
+// as Base64 (pyHSS AVP 609 -> S-CSCF nonce) or as 64 hex chars. Returns the 16-byte halves.
+bool ParseAkaNonce(const std::string &nonce, OctetString &rand, OctetString &autn)
+{
+    std::vector<uint8_t> raw;
+    auto tryHex = [&]() {
+        if (nonce.size() != 64)
+            return false;
+        for (char c : nonce)
+            if (!std::isxdigit(static_cast<unsigned char>(c)))
+                return false;
+        OctetString h = OctetString::FromHex(nonce);
+        if (h.length() != 32)
+            return false;
+        raw.assign(h.data(), h.data() + 32);
+        return true;
+    };
+    auto tryBase64 = [&]() {
+        if (nonce.size() % 4 != 0)
+            return false;
+        static const char *tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        int val = 0, bits = 0;
+        for (char c : nonce)
+        {
+            if (c == '=')
+                break;
+            const char *p = std::strchr(tbl, c);
+            if (!p)
+                return false;
+            val = (val << 6) | static_cast<int>(p - tbl);
+            bits += 6;
+            if (bits >= 8)
+            {
+                bits -= 8;
+                raw.push_back(static_cast<uint8_t>((val >> bits) & 0xFF));
+            }
+        }
+        return raw.size() == 32;
+    };
+
+    if (tryHex() || tryBase64())
+    {
+        rand = OctetString{std::vector<uint8_t>(raw.begin(), raw.begin() + 16)};
+        autn = OctetString{std::vector<uint8_t>(raw.begin() + 16, raw.end())};
+        return true;
+    }
+    return false;
+}
