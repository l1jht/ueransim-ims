+ImsClientTask::ImsClientTask(TaskBase *base)
+    : m_base{base}, m_regAuth(base->config->ims.privateIdentity, base->config->ims.password),
+      m_callAuth(base->config->ims.privateIdentity, base->config->ims.password), m_media{base}
+{
+    m_logger = m_base->logBase->makeUniqueLogger(m_base->config->getLoggerPrefix() + "ims");
+
+    // IMS AKA credentials: OPc derived from op/key (reusing the NAS-layer credentials).
+    if (m_base->config->key.length() == 16 && m_base->config->opC.length() == 16)
+    {
+        if (m_base->config->opType == OpType::OPC)
+        {
+            m_regAuth.setAkaCredentials(m_base->config->opC, m_base->config->amf);
+            m_callAuth.setAkaCredentials(m_base->config->opC, m_base->config->amf);
+        }
+        else
+        {
+            auto opc = crypto::milenage::CalculateOpC(m_base->config->opC, m_base->config->key);
+            m_regAuth.setAkaCredentials(opc, m_base->config->amf);
+            m_callAuth.setAkaCredentials(opc, m_base->config->amf);
+        }
+    }
+}
+
+void ImsClientTask::onStart()
+{
+}
+
+void ImsClientTask::onQuit()
+{
+}
+
+void ImsClientTask::onLoop()
+{
+    auto msg = take();
+    if (!msg)
+        return;
+
+    switch (msg->msgType)
+    {
+    case NtsMessageType::UE_APP_TO_IMS:
+        handleMessage(*msg);
+        break;
+    case NtsMessageType::TIMER_EXPIRED:
+        handleTimer(dynamic_cast<NmTimerExpired &>(*msg));
+        break;
+    default:
+        m_logger->unhandledNts(*msg);
+        break;
+    }
+}
+
+void ImsClientTask::handleMessage(NtsMessage &msg)
+{
+    auto &w = dynamic_cast<NmUeAppToIms &>(msg);
+    switch (w.present)
+    {
+    case NmUeAppToIms::SESSION_BOUND:
+        handleSessionBound(w);
+        break;
+    case NmUeAppToIms::SESSION_RELEASED:
+        handleSessionReleased(w);
+        break;
+    case NmUeAppToIms::DOWNLINK_DATA:
+        handleDownlinkData(w);
+        break;
+    case NmUeAppToIms::CLI_COMMAND:
+        handleCliCommand(w);
+        break;
+    }
+}
+
+void ImsClientTask::handleSessionBound(const NmUeAppToIms &msg)
+{
+    m_psi = msg.psi;
+    m_localIp = msg.localIp;
+    // P4: EPCO-provided P-CSCF wins; the configured one is the fallback.
+    m_pcscfIp = msg.pcscf.empty() ? m_base->config->ims.pcscf : msg.pcscf;
+    m_bound = true;
+
+    m_logger->info("IMS session bound [psi=%d, local=%s, pcscf=%s%s]", m_psi, m_localIp.c_str(), m_pcscfIp.c_str(),
+                   msg.pcscf.empty() ? " (config)" : " (EPCO)");
+
+    m_retryIndex = 0;
+    m_lastError.clear();
+    startRegistration();
+}
+
+void ImsClientTask::handleSessionReleased(const NmUeAppToIms &msg)
+{
+    if (!m_bound || msg.psi != m_psi)
+        return;
+
+    m_logger->info("IMS session released [psi=%d], stopping registration", m_psi);
+    m_bound = false;
+    m_psi = -1;
+    m_localIp.clear();
+    m_regState = ERegState::IDLE;
+    m_lastError.clear();
+    m_serviceRoute.clear();
+}
+
+void ImsClientTask::handleDownlinkData(const NmUeAppToIms &msg)
+{
+    std::string payload = ims::ExtractUdpPayload(msg.data);
+    if (payload.empty())
+        return;
+
+    // Media (P3): RTP packets are counted (and dropped, silence has no consumer).
+    if (payload.size() >= 12 && (static_cast<uint8_t>(payload[0]) & 0xC0) == 0x80 &&
+        (static_cast<uint8_t>(payload[1]) & 0x7F) == 0 && m_media.IsRunning())
+    {
+        m_mediaRxCount++;
+        return;
+    }
+
+    // A downlink message is either a response ("SIP/2.0 ...") or a request ("<METHOD> ...").
+    if (payload.rfind("SIP/2.0 ", 0) == 0)
+    {
+        handleSipResponse(payload);
+    }
+    else
+    {
+        handleCallRequest(ims::ParseSipRequest(payload));
+    }
+}
+
+void ImsClientTask::handleCliCommand(const NmUeAppToIms &msg)
+{
+    if (!msg.cmd)
+        return;
+
+    switch (msg.cmd->present)
+    {
+    case app::UeCliCommand::IMS_REGISTER:
+        if (!m_bound)
+        {
+            sendResponse(msg.address, "IMS is not bound to any session", true);
+            break;
+        }
+        if (m_regState == ERegState::REGISTERING)
+        {
+            sendResponse(msg.address, "registration already in progress", true);
+            break;
+        }
+        m_logger->info("IMS registration triggered by CLI");
+        m_retryIndex = 0;
+        m_lastError.clear();
+        startRegistration();
+        sendResponse(msg.address, "IMS registration started", false);
+        break;
+    case app::UeCliCommand::IMS_STATUS:
+        m_logger->debug("CLI ims-status requested");
+        sendResponse(msg.address, statusText(), false);
+        break;
+    case app::UeCliCommand::IMS_CALL:
+        if (!m_bound)
+        {
+            sendResponse(msg.address, "IMS is not bound to any session", true);
+            break;
+        }
+        if (m_regState != ERegState::REGISTERED)
+        {
+            sendResponse(msg.address, "IMS is not registered", true);
+            break;
+        }
+        if (m_callState != ECallState::IDLE)
+        {
+            sendResponse(msg.address, "A call is already in progress", true);
+            break;
+        }
+        if (msg.cmd->callUri.empty())
+        {
+            sendResponse(msg.address, "No call URI provided", true);
+            break;
+        }
+        m_logger->info("IMS call initiated to %s", msg.cmd->callUri.c_str());
+        startCall(msg.cmd->callUri);
+        sendResponse(msg.address, "IMS call initiated", false);
+        break;
+    case app::UeCliCommand::IMS_SMS:
+        if (!m_bound)
+        {
+            sendResponse(msg.address, "IMS is not bound to any session", true);
+            break;
+        }
+        if (m_regState != ERegState::REGISTERED)
+        {
+            sendResponse(msg.address, "IMS is not registered", true);
+            break;
+        }
+        if (msg.cmd->smsUri.empty() || msg.cmd->smsText.empty())
+        {
+            sendResponse(msg.address, "Usage: ims-sms <uri> <text>", true);
+            break;
+        }
+        sendSms(msg.cmd->smsUri, msg.cmd->smsText);
+        sendResponse(msg.address, "IMS SMS sent", false);
+        break;
+    case app::UeCliCommand::IMS_ANSWER:
+        if (m_callState == ECallState::RINGING)
+        {
+            m_logger->info("IMS call answered by CLI");
+            m_callState = ECallState::ANSWERING;
+            setTimer(TIMER_CALL_TIMEOUT, CALL_TIMEOUT_MS);
+            std::string sdp = ims::BuildMediaSdp(m_localIp, m_base->config->ims.mediaPort);
+            sendCallReply(m_pendingInvite, 200, "OK", sdp);
+            sendResponse(msg.address, "IMS call answered", false);
+
+            std::string peerIp;
+            int peerPort = 0;
+            if (ims::ParseSdpMedia(m_pendingInvite.body, peerIp, peerPort))
+                startMedia(peerIp, peerPort);
+        }
+        else
+        {
+            sendResponse(msg.address, "No incoming call to answer", true);
+        }
+        break;
+    case app::UeCliCommand::IMS_HANGUP:
+        if (m_callState == ECallState::IDLE)
+        {
+            sendResponse(msg.address, "No active call", true);
+            break;
+        }
+        hangupCall();
+        sendResponse(msg.address, "IMS call hangup", false);
+        break;
+    default:
+        break;
+    }
+}
+
+void ImsClientTask::handleTimer(const NmTimerExpired &msg)
+{
+    switch (msg.timerId)
+    {
+    case TIMER_REG_TIMEOUT:
+        if (m_regState == ERegState::REGISTERING)
+            onRegFail("registration attempt timeout");
+        break;
+    case TIMER_REG_RETRY:
+        if (m_regState == ERegState::FAILED)
+        {
+            m_regState = ERegState::REGISTERING;
+            m_usingAuth = false;
+            sendRegister(false);
+            armAttemptTimeout();
+        }
+        break;
+    case TIMER_RE_REGISTER:
+        if (m_regState == ERegState::REGISTERED)
+        {
+            // Stale duplicate timers (piled up during a retransmission storm) fire well
+            // before the scheduled re-registration interval; ignore triggers closer than
+            // 20% of the interval. A fixed guard would permanently block re-registration
+            // when the server issues a short expires (interval < guard).
+            using namespace std::chrono;
+            auto now = duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+            int64_t guardMs = static_cast<int64_t>(m_regExpires) * 900 / 5;
+            if (now - m_regSuccessTime < guardMs)
+            {
+                m_logger->debug("Ignoring stale re-registration timer");
+                break;
+            }
+            m_logger->info("Re-registration timer expired, refreshing registration");
+            m_regState = ERegState::REGISTERING;
+            m_usingAuth = false;
+            sendRegister(false);
+            armAttemptTimeout();
+        }
+        break;
+    case TIMER_TX_RETRANSMIT:
+        if (!m_txTable.empty())
+        {
+            auto bodies = m_txTable.tick();
+            m_logger->debug("Retransmitting SIP request(s) [count=%zu, table=%zu]", bodies.size(),
+                            m_txTable.size());
+            for (const auto &b : bodies)
+                sendSipUdp(b);
+            if (!m_txTable.empty())
+                setTimer(TIMER_TX_RETRANSMIT, TX_RETRANSMIT_MS);
+        }
+        break;
+    case TIMER_CALL_TIMEOUT:
+        if (m_callState == ECallState::CALLING || m_callState == ECallState::HANGING_UP ||
+            m_callState == ECallState::ANSWERING)
+        {
+            m_logger->warn("Call timed out [state=%s]", callStateName().c_str());
+            callFail("call timeout");
+        }
+        break;
+    case TIMER_MEDIA_SEND:
+        if (m_callState == ECallState::CONFIRMED)
+        {
+            m_media.Send();
+            setTimer(TIMER_MEDIA_SEND, MEDIA_SEND_MS);
+        }
+        break;
+    case TIMER_2XX_RETRANSMIT:
+        // RFC 3261 17.2.1 Timer G: keep retransmitting the 2xx until the ACK arrives.
+        // The CALL_TIMEOUT (ANSWERING) timer bounds the retransmission window.
+        if (m_2xxRetransmitActive && m_lastReplyCode == 200 && m_callState == ECallState::ANSWERING)
+        {
+            m_logger->debug("Retransmitting 2xx [200 OK]");
+            sendCallReply(m_pendingInvite, 200, "OK", m_lastReplyBody);
+            setTimer(TIMER_2XX_RETRANSMIT, TX_RETRANSMIT_MS);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void ImsClientTask::startRegistration()
+{
+    if (!m_bound)
+        return;
+
+    m_regState = ERegState::REGISTERING;
+    m_usingAuth = false;
+    m_authRetryCount = 0;
+    m_logger->info("Sending initial REGISTER");
+    sendRegister(false);
+    armAttemptTimeout();
+}
+
+void ImsClientTask::sendRegister(bool withAuth)
+{
+    if (!m_bound)
+        return;
+
+    m_cseq++;
+    if (m_regCallId.empty())
+        m_regCallId = generateId() + "@" + m_localIp;
+    if (m_regTag.empty())
+        m_regTag = generateId();
+    // A fresh Via branch is required for every transaction; the Call-ID and From tag stay constant across
+    // the challenge-response within one registration flow.
+    m_regBranch = "z9hG4bK" + generateId();
+
+    std::string authHeader;
+    if (withAuth)
+        authHeader = m_regAuth.authorization("REGISTER", ims::RegistrarUri(m_base->config->ims));
+
+    std::string body = ims::BuildRegister(m_base->config->ims, m_localIp, m_cseq, m_regCallId, m_regBranch, m_regTag,
+                                          authHeader);
+    auto packet = ims::BuildUdpPacket(body, m_localIp, m_pcscfIp, m_base->config->ims.sipPort,
+                                      m_base->config->ims.pcscfPort);
+
+    auto m = std::make_unique<NmUeAppToNas>(NmUeAppToNas::UPLINK_DATA_DELIVERY);
+    m->psi = m_psi;
+    m->data = std::move(packet);
+    m_base->nasTask->push(std::move(m));
+    m_lastRegCseq = m_cseq;
+
+    if (withAuth)
+        m_logger->debug("REGISTER sent (digest) [cseq=%d]", m_cseq);
+    else
+        m_logger->debug("REGISTER sent [cseq=%d]", m_cseq);
+}
+
+void ImsClientTask::sendSms(const std::string &uri, const std::string &text)
+{
+    m_smsCSeq++;
+    if (m_smsCallId.empty())
+        m_smsCallId = generateId() + "@" + m_localIp;
+    std::string branch = "z9hG4bK" + generateId();
+    std::string tag = generateId();
+
+    std::string body = ims::BuildMessage(m_base->config->ims, m_localIp, uri, m_smsCSeq, m_smsCallId, branch, tag, text);
+    sendSipUdp(body);
+
+    m_lastSmsResult = "sent";
+    armTx(m_smsCallId, m_smsCSeq, body);
+    m_logger->info("SMS sent to %s: %s", uri.c_str(), text.c_str());
+}
+
+void ImsClientTask::handleIncomingSms(const ims::SipRequestInfo &req)
+{
+    std::string peer = req.from.empty() ? "(unknown)" : req.from;
+    m_logger->info("SMS received from %s: %s", peer.c_str(), req.body.c_str());
+    m_smsHistory.push_back({peer, req.body});
+    if (m_smsHistory.size() > 10)
+        m_smsHistory.pop_front();
+
+    // Single transaction: acknowledge immediately (RFC 3428).
+    std::string reply = ims::BuildSipReply(m_base->config->ims, m_localIp, 200, "OK", req, m_dialogMyTag, "");
+    sendSipUdp(reply);
+}
+
+void ImsClientTask::startCall(const std::string &uri)
+{
+    m_callCallId = generateId() + "@" + m_localIp;
+    m_dialogMyTag = generateId();
+    m_remoteUri = uri;
+    m_remoteContact.clear();
+    m_dialogPeerTag.clear();
+    m_callUsingAuth = false;
+    m_callCSeq = 1;
+    m_callState = ECallState::CALLING;
+    m_callRouteSet = "<sip:" + m_pcscfIp + ":" + std::to_string(m_base->config->ims.pcscfPort) + ";lr>," + m_serviceRoute;
+
+    m_logger->info("Sending INVITE to %s", uri.c_str());
+    sendInvite(false);
+    setTimer(TIMER_CALL_TIMEOUT, CALL_TIMEOUT_MS);
+}
+
+void ImsClientTask::sendInvite(bool withAuth)
+{
+    std::string authHeader;
+    if (withAuth)
+        authHeader = m_callAuth.authorization("INVITE", m_remoteUri);
+
+    std::string body = ims::BuildInvite(m_base->config->ims, m_localIp, m_remoteUri, m_serviceRoute, m_callCallId,
+                                        "z9hG4bK" + generateId(), m_dialogMyTag, authHeader);
+
+    sendSipUdp(body);
+
+    armTx(m_callCallId, m_callCSeq, body);
+    m_logger->debug("INVITE sent [%s]", withAuth ? "digest" : "plain");
+}
+
+void ImsClientTask::sendAck()
+{
+    std::string body = ims::BuildInDialogRequest("ACK", m_localIp, m_base->config->ims, m_remoteUri, m_remoteContact,
+                                                 m_callRouteSet, m_callCallId, "z9hG4bK" + generateId(),
+                                                 m_base->config->ims.publicIdentity, m_dialogMyTag, m_remoteUri,
+                                                 m_dialogPeerTag, m_callCSeq);
+    sendSipUdp(body);
+    m_logger->debug("ACK sent");
+}
+
+void ImsClientTask::sendErrorAck()
+{
+    // ACK for a non-2xx final response to an INVITE (RFC 3261 17.1.1.3): sent to the
+    // P-CSCF, no Route/Contact, matching the failed transaction.
+    std::string body = ims::BuildErrorAck(m_base->config->ims, m_localIp, m_remoteUri, m_callCallId,
+                                          m_dialogMyTag, m_callCSeq);
+    sendSipUdp(body);
+    m_logger->debug("Error ACK sent [%d]", m_callCSeq);
+}
+
+void ImsClientTask::sendBye()
+{
+    m_callCSeq++;
+    std::string body = ims::BuildInDialogRequest("BYE", m_localIp, m_base->config->ims, m_remoteUri, m_remoteContact,
+                                                 m_callRouteSet, m_callCallId, "z9hG4bK" + generateId(),
+                                                 m_base->config->ims.publicIdentity, m_dialogMyTag, m_remoteUri,
+                                                 m_dialogPeerTag, m_callCSeq);
+    sendSipUdp(body);
+    armTx(m_callCallId, m_callCSeq, body);
+    m_logger->debug("BYE sent");
+}
+
+void ImsClientTask::hangupCall()
+{
+    if (m_callState == ECallState::CALLING)
+    {
+        m_logger->info("Cancelling ongoing call attempt");
+        callFail("cancelled by user");
+        return;
+    }
+    if (m_callState == ECallState::CONFIRMED)
+    {
+        m_logger->info("Sending BYE to hang up the call");
+        m_callState = ECallState::HANGING_UP;
+        sendBye();
+        setTimer(TIMER_CALL_TIMEOUT, CALL_TIMEOUT_MS);
+        return;
+    }
+    // RINGING/ANSWERING: no established dialog; just clear.
+    callFail("hangup");
+}
+
+void ImsClientTask::handleCallResponse(const ims::SipResponseInfo &info)
+{
+    // Provisional responses are informational.
+    if (info.statusCode >= 100 && info.statusCode < 200)
+        return;
+
+    if (m_callState == ECallState::CALLING)
+    {
+        if (info.statusCode == 401 && !m_callUsingAuth)
+        {
+            if (!info.challenge.has_value() || !m_callAuth.beginChallenge(*info.challenge, m_base->config->ims.realm))
+            {
+                callFail("401 without a usable challenge");
+                return;
+            }
+            m_callUsingAuth = true;
+            m_logger->info("Received 401 challenge, sending authenticated INVITE");
+            sendInvite(true);
+            return;
+        }
+        if (info.statusCode == 200)
+        {
+            m_dialogPeerTag = info.toTag;
+            m_remoteContact = info.contact;
+            // In-dialog requests from the caller follow the Record-Route set (forward order,
+            // starting with its own P-CSCF); Service-Route lacks the dialog id used by the S-CSCF.
+            m_callRouteSet = JoinRouteSet(info.recordRoutes, false);
+            setTimer(TIMER_CALL_TIMEOUT, 0);
+            m_logger->info("Call established (200 OK), sending ACK");
+            sendAck();
+            m_callState = ECallState::CONFIRMED;
+
+            // Media (P3): the 200 OK SDP answer carries the (rtpengine) media address.
+            std::string peerIp;
+            int peerPort = 0;
+            if (ims::ParseSdpMedia(info.body, peerIp, peerPort))
+                startMedia(peerIp, peerPort);
+            return;
+        }
+        if (info.statusCode >= 300)
+        {
+            sendErrorAck();
+            callFail(std::to_string(info.statusCode) + " " + info.reasonPhrase);
+            return;
+        }
+    }
+    else if (m_callState == ECallState::HANGING_UP)
+    {
+        if (info.statusCode == 200)
+        {
+            m_logger->info("BYE acknowledged, call ended");
+            callFail("");
+        }
+        else if (info.statusCode >= 300)
+        {
+            m_logger->warn("BYE failed [%d %s]", info.statusCode, info.reasonPhrase.c_str());
+            callFail("");
+        }
+    }
+}
+
+void ImsClientTask::handleCallRequest(const ims::SipRequestInfo &req)
+{
+    if (req.method.empty())
+        return;
+
+    m_logger->debug("SIP request received [%s]", req.method.c_str());
+    if (req.method == "MESSAGE")
+    {
+        handleIncomingSms(req);
+        return;
+    }
+    if (req.method == "INVITE")
+    {
+        if (m_callState != ECallState::IDLE)
+        {
+            // INVITE retransmission (same Call-ID + CSeq) of the in-progress call:
+            // re-send the last reply instead of treating it as a new call.
+            if (req.callId == m_callCallId && req.cseq == m_callCSeq && m_lastReplyCode != 0)
+            {
+                m_logger->debug("INVITE retransmission, re-sending [%d %s]", m_lastReplyCode,
+                                m_lastReplyReason.c_str());
+                sendCallReply(m_pendingInvite, m_lastReplyCode, m_lastReplyReason, m_lastReplyBody);
+            }
+            else
+            {
+                m_logger->warn("Busy, rejecting incoming INVITE");
+                sendCallReply(req, 486, "Busy Here", "");
+            }
+            return;
+        }
+
+        m_pendingInvite = req;
+        m_callCallId = req.callId;
+        m_callCSeq = req.cseq;
+        m_lastReplyCode = 0;
+        m_2xxRetransmitActive = false;
+        m_dialogMyTag = generateId();
+        m_dialogPeerTag = req.fromTag;
+        m_remoteUri = StripUriTag(req.from);
+        m_remoteContact = req.contact;
+        // In-dialog requests from the callee must follow the Record-Route set (reversed,
+        // starting with its own P-CSCF); Service-Route lacks the dialog id used by the S-CSCF.
+        m_callRouteSet = JoinRouteSet(req.recordRoutes, true);
+        if (m_callRouteSet.empty())
+            m_callRouteSet = "<sip:" + m_pcscfIp + ":" + std::to_string(m_base->config->ims.pcscfPort) + ";lr>," +
+                             m_serviceRoute;
+
+        m_logger->info("Incoming INVITE from %s, autoAnswer=%d", req.from.c_str(),
+                       m_base->config->ims.autoAnswer ? 1 : 0);
+        sendCallReply(req, 180, "Ringing", "");
+        m_lastReplyCode = 180;
+        m_lastReplyReason = "Ringing";
+        m_lastReplyBody.clear();
+
+        if (m_base->config->ims.autoAnswer)
+        {
+            m_callState = ECallState::ANSWERING;
+            setTimer(TIMER_CALL_TIMEOUT, CALL_TIMEOUT_MS);
+            std::string sdp = ims::BuildMediaSdp(m_localIp, m_base->config->ims.mediaPort);
+            sendCallReply(req, 200, "OK", sdp);
+            m_lastReplyCode = 200;
+            m_lastReplyReason = "OK";
+            m_lastReplyBody = sdp;
+
+            // RFC 3261 17.2.1 (Timer G): retransmit the 2xx every 500ms until the ACK
+            // arrives or the call times out - a lost 2xx would otherwise strand the call.
+            m_2xxRetransmitActive = true;
+            setTimer(TIMER_2XX_RETRANSMIT, TX_RETRANSMIT_MS);
+
+            // Media (P3): the INVITE SDP offer carries the (rtpengine) media address.
+            std::string peerIp;
+            int peerPort = 0;
+            if (ims::ParseSdpMedia(req.body, peerIp, peerPort))
+                startMedia(peerIp, peerPort);
+        }
+        else
+        {
+            m_callState = ECallState::RINGING;
+        }
+    }
+    else if (req.method == "ACK")
+    {
+        if (m_callState == ECallState::ANSWERING)
+        {
+            m_logger->info("ACK received, call confirmed");
+            m_2xxRetransmitActive = false;  // ACK acknowledges the 2xx; stop retransmitting
+            m_callState = ECallState::CONFIRMED;
+        }
+    }
+    else if (req.method == "BYE")
+    {
+        m_logger->info("BYE received, ending call");
+        stopMedia();
+        sendCallReply(req, 200, "OK", "");
+        m_callState = ECallState::IDLE;
+        m_callCallId.clear();
+        m_remoteContact.clear();
+        m_dialogPeerTag.clear();
+    }
+}
+
+void ImsClientTask::startMedia(const std::string &peerIp, int peerPort)
+{
+    m_media.Start(m_psi, m_localIp, m_base->config->ims.mediaPort, peerIp, peerPort, m_mediaSsrc);
+    m_mediaSsrc++;
+    setTimer(TIMER_MEDIA_SEND, MEDIA_SEND_MS);
+    m_logger->info("Media started [peer=%s:%d]", peerIp.c_str(), peerPort);
+}
+
+void ImsClientTask::stopMedia()
+{
+    m_media.Stop();
+    m_logger->debug("Media stopped [tx=%llu]", static_cast<unsigned long long>(m_media.TxCount()));
+}
+
+void ImsClientTask::sendSipUdp(const std::string &body)
+{
+    auto packet = ims::BuildUdpPacket(body, m_localIp, m_pcscfIp, m_base->config->ims.sipPort,
+                                      m_base->config->ims.pcscfPort);
+    auto m = std::make_unique<NmUeAppToNas>(NmUeAppToNas::UPLINK_DATA_DELIVERY);
+    m->psi = m_psi;
+    m->data = std::move(packet);
+    m_base->nasTask->push(std::move(m));
+}
+
+void ImsClientTask::sendCallReply(const ims::SipRequestInfo &req, int code, const std::string &reason,
+                                  const std::string &body)
+{
+    std::string reply = ims::BuildSipReply(m_base->config->ims, m_localIp, code, reason, req, m_dialogMyTag, body);
+    sendSipUdp(reply);
+    m_logger->debug("SIP reply sent [%d %s]", code, reason.c_str());
+}
+
+void ImsClientTask::callFail(const std::string &reason)
+{
+    if (!reason.empty())
+        m_logger->warn("Call failed [%s]", reason.c_str());
+    stopMedia();
+    m_txTable.cancelAll();
+    cancelTimer(TIMER_TX_RETRANSMIT);
+    cancelTimer(TIMER_CALL_TIMEOUT);
+    cancelTimer(TIMER_2XX_RETRANSMIT);
+    m_2xxRetransmitActive = false;
+    m_callState = ECallState::IDLE;
+    m_callCallId.clear();
+    m_remoteContact.clear();
+    m_dialogPeerTag.clear();
+    m_lastReplyCode = 0;
+    m_lastReplyReason.clear();
+    m_lastReplyBody.clear();
+    m_pendingInvite = ims::SipRequestInfo{};
+}
+
+void ImsClientTask::armTx(const std::string &callId, int cseq, const std::string &body)
+{
+    bool wasEmpty = m_txTable.empty();
+    auto res = m_txTable.arm(callId, cseq, body);
+    if (res == ims::EArmResult::ADDED_WITH_EVICTION)
+        m_logger->warn("Transaction table full, evicting oldest entry");
+    if (wasEmpty)
+        setTimer(TIMER_TX_RETRANSMIT, TX_RETRANSMIT_MS);
+}
+
+void ImsClientTask::handleSipResponse(const std::string &text)
+{
+    auto info = ims::ParseSipResponse(text);
+    if (info.statusCode <= 0)
+        return;
+
+    m_logger->debug("SIP response received [%d %s]", info.statusCode, info.reasonPhrase.c_str());
+
+    // A final response ends its client transaction: stop retransmitting that request only.
+    // (1xx provisionals deliberately do not cancel, preserving prior behavior.)
+    if (info.statusCode >= 200)
+        m_txTable.cancel(info.callId, info.cseq);
+
+    // SMS (MESSAGE) transaction: single out-of-dialog transaction; the 200 OK ends it.
+    if (!m_smsCallId.empty() && !info.callId.empty() && info.callId == m_smsCallId)
+    {
+        if (info.cseq != m_smsCSeq)
+        {
+            m_logger->debug("Ignoring stale SMS response [cseq=%d, current=%d]", info.cseq, m_smsCSeq);
+            return;
+        }
+        if (info.statusCode >= 200)
+        {
+            m_lastSmsResult = (info.statusCode == 200)
+                                  ? "delivered (" + std::to_string(info.statusCode) + ")"
+                                  : "failed (" + std::to_string(info.statusCode) + " " + info.reasonPhrase + ")";
+            m_logger->info("SMS result: %s", m_lastSmsResult.c_str());
+        }
+        return;
+    }
+
+    // Dispatch to the call state machine when the response belongs to an active call dialog.
+    if (m_callState != ECallState::IDLE && !info.callId.empty() && info.callId == m_callCallId)
+    {
+        handleCallResponse(info);
+        return;
+    }
+
+    if (m_regState != ERegState::REGISTERING && m_regState != ERegState::REGISTERED)
+        return;
+
+    // Provisional responses (1xx) are informational; ignore them.
+    if (info.statusCode >= 100 && info.statusCode < 200)
+        return;
+
+    if (info.statusCode == 401)
+    {
+        if (m_regState != ERegState::REGISTERING)
+            return;
+        if (m_usingAuth)
+        {
+            // A 401 on an already-authenticated REGISTER usually means the nonce was
+            // consumed/expired (server-side race). Re-challenge once per flow; a second
+            // 401 is a hard credential failure.
+            if (m_authRetryCount++ >= 1)
+            {
+                onRegFail("401 after re-challenge");
+                return;
+            }
+            m_usingAuth = false;
+            m_logger->info("401 on authenticated REGISTER, re-challenging");
+        }
+
+        if (!info.challenge.has_value() || !m_regAuth.beginChallenge(*info.challenge, m_base->config->ims.realm))
+        {
+            onRegFail("401 without a usable challenge");
+            return;
+        }
+
+        m_usingAuth = true;
+
+        m_logger->info("Received 401 challenge, sending authenticated REGISTER");
+        sendRegister(true);
+        armAttemptTimeout();
+        return;
+    }
+
+    if (info.statusCode == 200)
+    {
+        // A retransmitted 200 OK (same CSeq as the last sent REGISTER) must not be
+        // treated as a fresh success: it would re-arm the re-registration timer and
+        // pile up stale timers, producing a registration loop.
+        if (info.cseq == m_lastRegCseq && m_regState == ERegState::REGISTERED)
+            return;
+
+        int expires = info.expires.value_or(m_base->config->ims.expires);
+        if (!info.serviceRoutes.empty())
+            m_serviceRoute = info.serviceRoutes.front();
+        onRegSuccess(expires);
+        return;
+    }
+
+    // Any other response is a registration failure.
+    onRegFail(std::to_string(info.statusCode) + " " + info.reasonPhrase);
+}
+
+void ImsClientTask::onRegFail(const std::string &reason)
+{
+    if (m_regState != ERegState::REGISTERING)
+        return;
+
+    m_lastError = reason;
+    m_regState = ERegState::FAILED;
+    m_logger->warn("IMS registration failed [%s]", reason.c_str());
+    scheduleRetry();
+}
+
+void ImsClientTask::onRegSuccess(int expires)
+{
+    m_regState = ERegState::REGISTERED;
+    m_retryIndex = 0;
+    m_authRetryCount = 0;
+    m_lastError.clear();
+    m_regExpires = expires;
+    using namespace std::chrono;
+    m_regSuccessTime =
+        duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+
+    m_logger->info("IMS registration succeeded [expires=%d]", m_regExpires);
+    scheduleReRegister();
+}
+
+void ImsClientTask::scheduleRetry()
+{
+    static constexpr const int delays[] = {5000, 15000, 45000, 60000};
+    int idx = m_retryIndex;
+    if (idx >= 4)
+        idx = 3;
+    m_retryIndex++;
+    m_logger->warn("Retrying registration in %d ms", delays[idx]);
+    setTimer(TIMER_REG_RETRY, delays[idx]);
+}
+
+void ImsClientTask::armAttemptTimeout()
+{
+    setTimer(TIMER_REG_TIMEOUT, REG_ATTEMPT_TIMEOUT_MS);
+}
+
+void ImsClientTask::scheduleReRegister()
+{
+    int64_t delayMs = static_cast<int64_t>(m_regExpires) * 900; // 90% of the server-issued expiry
+    m_logger->info("Scheduling re-registration in %lld ms", static_cast<long long>(delayMs));
+    setTimer(TIMER_RE_REGISTER, delayMs);
+}
+
+void ImsClientTask::sendResponse(const InetAddress &address, const std::string &output, bool isError)
+{
+    m_logger->debug("Sending CLI response [isError=%d, len=%zu]", isError ? 1 : 0, output.size());
+    m_base->cliCallbackTask->push(std::make_unique<app::NwCliSendResponse>(address, output, isError));
+}
+
+std::string ImsClientTask::generateId()
+{
+    uint64_t now = static_cast<uint64_t>(utils::CurrentTimeMillis());
+    uint64_t counter = m_rngCounter++;
+    return std::to_string(now) + "-" + std::to_string(counter);
+}
+
+std::string ImsClientTask::regStateName() const
+{
+    switch (m_regState)
+    {
+    case ERegState::IDLE:
+        return "IDLE";
+    case ERegState::REGISTERING:
+        return "REGISTERING";
+    case ERegState::REGISTERED:
+        return "REGISTERED";
+    case ERegState::FAILED:
+        return "FAILED";
+    }
+    return "UNKNOWN";
+}
+
+std::string ImsClientTask::callStateName() const
+{
+    switch (m_callState)
+    {
+    case ECallState::IDLE:
+        return "IDLE";
+    case ECallState::CALLING:
+        return "CALLING";
+    case ECallState::RINGING:
+        return "RINGING";
+    case ECallState::ANSWERING:
+        return "ANSWERING";
+    case ECallState::CONFIRMED:
+        return "CONFIRMED";
+    case ECallState::HANGING_UP:
+        return "HANGING_UP";
+    }
+    return "UNKNOWN";
+}
+
+std::string ImsClientTask::statusText()
+{
+    Json json = Json::Obj({
+        {"state", regStateName()},
+        {"registered", m_regState == ERegState::REGISTERED},
+        {"expires", m_regState == ERegState::REGISTERED ? m_regExpires : -1},
+        {"retryCount", static_cast<int32_t>(m_retryIndex)},
+        {"bound", m_bound},
+        {"psi", m_bound ? m_psi : -1},
+        {"localIp", m_bound ? m_localIp : ""},
+        {"error", m_lastError},
+        {"callState", callStateName()},
+        {"callId", m_callState != ECallState::IDLE ? m_callCallId : ""},
+        {"remote", m_callState != ECallState::IDLE ? m_remoteUri : ""},
+        {"mediaTxCount", static_cast<int64_t>(m_media.TxCount())},
+        {"mediaRxCount", static_cast<int64_t>(m_mediaRxCount)},
+        {"smsResult", m_lastSmsResult},
+        {"smsHistory", smsHistoryText()},
+    });
+    return json.dumpJson();
+}
+
+std::string ImsClientTask::smsHistoryText()
+{
+    std::string out;
+    for (const auto &entry : m_smsHistory)
+    {
+        if (!out.empty())
+            out += " | ";
+        out += entry.first + ": " + entry.second;
+    }
+    return out;
+}
+
+} // namespace nr::ue
