@@ -0,0 +1,199 @@
+//
+// This file is a part of UERANSIM project.
+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+#include "packet.hpp"
+
+#include <cstring>
+
+namespace nr::ue
+{
+namespace ims
+{
+
+namespace
+{
+
+bool ParseIpBytes(const std::string &ip, uint8_t out[4])
+{
+    unsigned int parts[4];
+    if (std::sscanf(ip.c_str(), "%u.%u.%u.%u", &parts[0], &parts[1], &parts[2], &parts[3]) != 4)
+        return false;
+    for (auto &p : parts)
+    {
+        if (p > 255)
+            return false;
+    }
+    out[0] = static_cast<uint8_t>(parts[0]);
+    out[1] = static_cast<uint8_t>(parts[1]);
+    out[2] = static_cast<uint8_t>(parts[2]);
+    out[3] = static_cast<uint8_t>(parts[3]);
+    return true;
+}
+
+// RFC 1071 internet checksum (ones' complement). Kept internal; verified via BuildUdpPacket.
+uint16_t InetChecksum(const uint8_t *data, size_t len)
+{
+    uint32_t sum = 0;
+    size_t i = 0;
+    for (; i + 1 < len; i += 2)
+        sum += static_cast<uint32_t>(data[i]) << 8 | data[i + 1];
+    if (i < len)
+        sum += static_cast<uint32_t>(data[i]) << 8;
+
+    while (sum >> 16)
+        sum = (sum & 0xFFFF) + (sum >> 16);
+
+    return static_cast<uint16_t>(~sum);
+}
+
+} // namespace
+
+OctetString BuildUdpPacket(const std::string &payload, const std::string &srcIp, const std::string &dstIp, int sport,
+                           int dport)
+{
+    uint8_t src[4];
+    uint8_t dst[4];
+    if (!ParseIpBytes(srcIp, src) || !ParseIpBytes(dstIp, dst))
+        return {};
+
+    uint16_t totalLen = static_cast<uint16_t>(20 + 8 + payload.size());
+    uint16_t udpLen = static_cast<uint16_t>(8 + payload.size());
+
+    OctetString packet;
+    packet.appendOctet(0x45); // version 4, IHL 5
+    packet.appendOctet(0x00); // TOS
+    packet.appendOctet(static_cast<uint8_t>(totalLen >> 8));
+    packet.appendOctet(static_cast<uint8_t>(totalLen & 0xFF));
+    packet.appendOctet(0x00); // identification high
+    packet.appendOctet(0x00); // identification low
+    packet.appendOctet(0x00); // flags/frag
+    packet.appendOctet(0x00); // flags/frag
+    packet.appendOctet(64);   // TTL
+    packet.appendOctet(17);   // UDP
+    packet.appendOctet(0x00); // checksum high (computed below)
+    packet.appendOctet(0x00); // checksum low
+    packet.appendOctet(src[0]);
+    packet.appendOctet(src[1]);
+    packet.appendOctet(src[2]);
+    packet.appendOctet(src[3]);
+    packet.appendOctet(dst[0]);
+    packet.appendOctet(dst[1]);
+    packet.appendOctet(dst[2]);
+    packet.appendOctet(dst[3]);
+
+    // UDP header
+    packet.appendOctet(static_cast<uint8_t>(sport >> 8));
+    packet.appendOctet(static_cast<uint8_t>(sport & 0xFF));
+    packet.appendOctet(static_cast<uint8_t>(dport >> 8));
+    packet.appendOctet(static_cast<uint8_t>(dport & 0xFF));
+    packet.appendOctet(static_cast<uint8_t>(udpLen >> 8));
+    packet.appendOctet(static_cast<uint8_t>(udpLen & 0xFF));
+    packet.appendOctet(0x00); // checksum high (computed below)
+    packet.appendOctet(0x00); // checksum low
+
+    for (char c : payload)
+        packet.appendOctet(static_cast<uint8_t>(c));
+
+    // IPv4 header checksum over the 20-byte header.
+    const uint8_t *ipHdr = packet.data();
+    uint16_t ipChecksum = InetChecksum(ipHdr, 20);
+    packet.data()[10] = static_cast<uint8_t>(ipChecksum >> 8);
+    packet.data()[11] = static_cast<uint8_t>(ipChecksum & 0xFF);
+
+    // UDP checksum with the IPv4 pseudo-header.
+    uint8_t pseudo[12];
+    std::memcpy(pseudo, src, 4);
+    std::memcpy(pseudo + 4, dst, 4);
+    pseudo[8] = 0;
+    pseudo[9] = 17;
+    pseudo[10] = static_cast<uint8_t>(udpLen >> 8);
+    pseudo[11] = static_cast<uint8_t>(udpLen & 0xFF);
+
+    uint32_t sum = 0;
+    auto addSum = [&sum](const uint8_t *p, size_t len)
+    {
+        for (size_t i = 0; i + 1 < len; i += 2)
+            sum += static_cast<uint32_t>(p[i]) << 8 | p[i + 1];
+    };
+    addSum(pseudo, 12);
+    for (int i = 0; i < 2; i++)
+    {
+        uint16_t u16 = static_cast<uint16_t>((packet.data()[20 + i * 2] << 8) | packet.data()[21 + i * 2]);
+        sum += u16;
+    }
+    uint16_t u16 = static_cast<uint16_t>((packet.data()[24] << 8) | packet.data()[25]);
+    sum += u16;
+    u16 = static_cast<uint16_t>((packet.data()[26] << 8) | packet.data()[27]);
+    sum += u16;
+    addSum(packet.data() + 28, payload.size());
+    // RFC 768: an odd-length payload's final byte is padded with a zero in the checksum.
+    if (payload.size() % 2 == 1)
+        sum += static_cast<uint32_t>(packet.data()[28 + payload.size() - 1]) << 8;
+
+    while (sum >> 16)
+        sum = (sum & 0xFFFF) + (sum >> 16);
+    uint16_t udpChecksum = static_cast<uint16_t>(~sum);
+    if (udpChecksum == 0)
+        udpChecksum = 0xFFFF;
+    packet.data()[26] = static_cast<uint8_t>(udpChecksum >> 8);
+    packet.data()[27] = static_cast<uint8_t>(udpChecksum & 0xFF);
+
+    return packet;
+}
+
+bool IsUdpPacket(const OctetString &packet, int dstPort)
+{
+    if (packet.length() < 28)
+        return false;
+    const uint8_t *d = packet.data();
+    if ((d[0] >> 4) != 4) // IPv4 only
+        return false;
+    if (d[9] != 17) // UDP
+        return false;
+    int dport = (static_cast<int>(d[22]) << 8) | d[23];
+    return dport == dstPort;
+}
+
+std::string ExtractUdpPayload(const OctetString &packet)
+{
+    if (packet.length() < 28)
+        return {};
+    return std::string(reinterpret_cast<const char *>(packet.data() + 28), packet.length() - 28);
+}
+
+OctetString BuildRtpPacket(const std::string &localIp, int localPort, const std::string &peerIp, int peerPort,
+                           uint32_t ssrc, uint16_t seq, uint32_t ts)
+{
+    // RTP header (12 bytes): V=2, P=0, X=0, CC=0, M=0, PT=0 (PCMU)
+    uint8_t rtp[12];
+    rtp[0] = 0x80; // V=2, no padding/extension/CSRC
+    rtp[1] = 0x00; // PT=0
+    rtp[2] = (uint8_t)((seq >> 8) & 0xFF);
+    rtp[3] = (uint8_t)(seq & 0xFF);
+    rtp[4] = (uint8_t)((ts >> 24) & 0xFF);
+    rtp[5] = (uint8_t)((ts >> 16) & 0xFF);
+    rtp[6] = (uint8_t)((ts >> 8) & 0xFF);
+    rtp[7] = (uint8_t)(ts & 0xFF);
+    rtp[8] = (uint8_t)((ssrc >> 24) & 0xFF);
+    rtp[9] = (uint8_t)((ssrc >> 16) & 0xFF);
+    rtp[10] = (uint8_t)((ssrc >> 8) & 0xFF);
+    rtp[11] = (uint8_t)(ssrc & 0xFF);
+
+    // 160 bytes of PCMU silence (μ-law zero value)
+    std::string payload;
+    payload.reserve(160);
+    for (int i = 0; i < 160; i++)
+        payload.push_back(static_cast<char>(0xFF)); // μ-law silence code (0xFF = -0)
+
+    std::string body(reinterpret_cast<const char *>(rtp), sizeof(rtp));
+    body += payload;
+    return BuildUdpPacket(body, localIp, peerIp, localPort, peerPort);
+}
+
+} // namespace ims
+} // namespace nr::ue
