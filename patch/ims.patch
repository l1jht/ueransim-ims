+OctetString UeAppTask::reassembleIpv4Fragment(OctetString packet)
+{
+    if (packet.length() < 20)
+        return packet;
+    const uint8_t *d = packet.data();
+    if ((d[0] >> 4) != 4)
+        return packet;
+
+    int ihl = (d[0] & 0x0F) * 4;
+    if (ihl < 20 || (int)packet.length() < ihl)
+        return packet;
+    int totalLen = (d[2] << 8) | d[3];
+    if (totalLen > (int)packet.length() || totalLen < ihl)
+        return packet;
+
+    bool moreFrag = (d[6] & 0x20) != 0;
+    int offset = (((d[6] & 0x1F) << 8) | d[7]) * 8;
+    if (!moreFrag && offset == 0)
+        return packet; // not fragmented
+
+    uint32_t key = (d[12] << 24) | (d[13] << 16) | (d[14] << 8) | d[15];
+    key = (key << 16) | (d[4] << 8) | d[5];
+
+    auto it = m_fragBufs.find(key);
+    if (it == m_fragBufs.end())
+    {
+        Ipv4FragmentBuf buf;
+        buf.key = key;
+        it = m_fragBufs.emplace(key, std::move(buf)).first;
+    }
+    Ipv4FragmentBuf &buf = it->second;
+    buf.lastSeen = NowMillis();
+
+    int fragLen = totalLen - ihl;
+    int end = offset + fragLen;
+    if (end > (int)buf.data.size())
+        buf.data.resize(end);
+    std::memcpy(buf.data.data() + offset, d + ihl, fragLen);
+
+    if (offset == 0 && ihl == 20)
+        std::memcpy(buf.ipHeader, d, 20);
+    buf.fragCount++;
+
+    if (!moreFrag)
+    {
+        buf.gotLast = true;
+        buf.totalLen = end;
+    }
+
+    if (!buf.gotLast || (int)buf.data.size() < buf.totalLen)
+        return OctetString{}; // still incomplete
+
+    std::vector<uint8_t> raw;
+    raw.reserve(20 + buf.totalLen);
+    raw.insert(raw.end(), buf.ipHeader, buf.ipHeader + 20);
+    raw.insert(raw.end(), buf.data.begin(), buf.data.begin() + buf.totalLen);
+    m_fragBufs.erase(key);
+
+    // Fix the IP header for the reassembled datagram: clear fragmentation fields, set total length,
+    // and recompute the header checksum.
+    uint8_t *h = raw.data();
+    int len = 20 + buf.totalLen;
+    h[2] = (uint8_t)((len >> 8) & 0xFF);
+    h[3] = (uint8_t)(len & 0xFF);
+    h[6] = 0; // MF
+    h[7] = 0; // frag offset
+    int sum = 0;
+    for (int i = 0; i < 20; i += 2)
+    {
+        int word = ((h[i] & 0xFF) << 8) | (h[i + 1] & 0xFF);
+        sum += word;
+        while (sum > 0xFFFF)
+            sum = (sum & 0xFFFF) + (sum >> 16);
+    }
+    sum = ~sum & 0xFFFF;
+    h[10] = (uint8_t)((sum >> 8) & 0xFF);
+    h[11] = (uint8_t)(sum & 0xFF);
+    return OctetString(std::move(raw));
+}
