+#include <utils/octet_string.hpp>
+
+namespace nr::ue
+{
+
+class TaskBase;
+
+namespace ims
+{
+
+// P3 media sender: best-effort PCMU silence stream, decoupled from the call state machine.
+// Sends a 20 ms PCMU silence frame every 20 ms over the IMS PDU session (direct NAS push).
+class RtpSender
+{
+  private:
+    TaskBase *m_base;
+    int m_psi{0};
+    std::string m_localIp;
+    int m_localPort{0};
+    std::string m_peerIp;
+    int m_peerPort{0};
+    int m_ssrc{0};
+    uint16_t m_seq{0};
+    uint32_t m_ts{0};
+    uint64_t m_txCount{0};
+
+  public:
+    explicit RtpSender(TaskBase *base);
+
+    // Binds the local endpoint and starts sending towards the peer media address.
+    void Start(int psi, const std::string &localIp, int localPort, const std::string &peerIp, int peerPort,
+               uint32_t ssrc);
+    void Stop();
+
+    // Sends one 20 ms silence frame over the IMS PDU session (driven by the call task timer).
+    void Send();
+
+    bool IsRunning() const;
+    uint64_t TxCount() const;
+};
+
+} // namespace ims
