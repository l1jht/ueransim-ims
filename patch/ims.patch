+void TestAkaChallenge()
+{
+    // Real vector produced by pyHSS (key=8baf..., opc=8e27..., amf=8000, sqn=401, plmn=00101f).
+    const std::string rand = "8e2b76ca9754ebea67f3dfbeb490ef9a";
+    const std::string autn = "42c0b55ca18380008e268f667958321d";
+    const std::string xres = "b148a494f3fb4077";
+
+    DigestAuth auth("001011234567896@ims.mnc001.mcc001.3gppnetwork.org", "8baf473f2f8fd09487cccbd7097c6862");
+    auth.setAkaCredentials(OctetString::FromHex("8e27b6af0e692e750f32667a3b14605d"),
+                           OctetString::FromHex("8000"));
+
+    SipAuthChallenge ch;
+    ch.realm = "ims.mnc001.mcc001.3gppnetwork.org";
+    ch.nonce = rand + autn; // RAND||AUTN (64 hex)
+    ch.algorithm = "AKAv1-MD5";
+    ch.qopOptions = {"auth"};
+    CHECK(auth.beginChallenge(ch, "fallback"));
+    CHECK(auth.isAka());
+    // AUTN validation: SEP bit + MAC-A must pass with the UERANSIM Milenage.
+    CHECK(auth.validateAutn());
+
+    auto hdr = auth.authorization("REGISTER", "sip:ims.mnc001.mcc001.3gppnetwork.org");
+    CHECK(hdr.find("algorithm=AKAv1-MD5") != std::string::npos);
+    CHECK(hdr.find("response=\"") != std::string::npos);
+    // response is a 32-hex digest
+    auto pos = hdr.find("response=\"");
+    CHECK(pos != std::string::npos);
+    CHECK(hdr.substr(pos + 10, 32).find('"') == std::string::npos);
+
+    // MD5 mode still works and reports non-AKA.
+    DigestAuth md5("u@d", "p");
+    SipAuthChallenge mch;
+    mch.realm = "r";
+    mch.nonce = "nonce123";
+    mch.qopOptions = {"auth"};
+    CHECK(md5.beginChallenge(mch, "r"));
+    CHECK(!md5.isAka());
+    CHECK(md5.authorization("REGISTER", "sip:r").find("algorithm=MD5") != std::string::npos);
+
+    // Corrupt AUTN must fail validation (MAC mismatch).
+    DigestAuth bad("u@d", "8baf473f2f8fd09487cccbd7097c6862");
+    bad.setAkaCredentials(OctetString::FromHex("8e27b6af0e692e750f32667a3b14605d"),
+                          OctetString::FromHex("8000"));
+    SipAuthChallenge bch;
+    bch.realm = "r";
+    bch.nonce = rand + "42c0b55ca18380008e268f667958321e"; // flipped last MAC byte
+    bch.algorithm = "AKAv1-MD5";
+    CHECK(bad.beginChallenge(bch, "r"));
+    CHECK(!bad.validateAutn());
+
+    // Base64-encoded nonce (pyHSS AVP 609 -> S-CSCF nonce) must parse too:
+    // base64(hex-rand || hex-autn) of the same vector.
+    auto b64 = [](const std::string &hex) {
+        static const char *tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        std::string out;
+        int val = 0, bits = 0;
+        for (char c : hex)
+        {
+            val = (val << 4) | (std::isxdigit(static_cast<unsigned char>(c)) ? (c <= '9' ? c - '0' : std::tolower(c) - 'a' + 10) : 0);
+            bits += 4;
+            if (bits >= 6)
+            {
+                bits -= 6;
+                out.push_back(tbl[(val >> bits) & 0x3F]);
+            }
+        }
+        if (bits > 0)
+            out.push_back(tbl[(val << (6 - bits)) & 0x3F]);
+        while (out.size() % 4)
+            out.push_back('=');
+        return out;
+    };
+    DigestAuth b64auth("001011234567896@ims.mnc001.mcc001.3gppnetwork.org", "8baf473f2f8fd09487cccbd7097c6862");
+    b64auth.setAkaCredentials(OctetString::FromHex("8e27b6af0e692e750f32667a3b14605d"),
+                              OctetString::FromHex("8000"));
+    SipAuthChallenge bch2;
+    bch2.realm = "r";
+    bch2.nonce = b64(rand + autn);
+    bch2.algorithm = "AKAv1-MD5";
+    CHECK(b64auth.beginChallenge(bch2, "r"));
+    CHECK(b64auth.validateAutn());
+    CHECK(b64auth.authorization("REGISTER", "sip:r").find("algorithm=AKAv1-MD5") != std::string::npos);
+}
