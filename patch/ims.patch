+// Copyright (c) 2023 ALİ GÜNGÖR.
+//
+// https://github.com/aligungr/UERANSIM/
+// See README, LICENSE, and CONTRIBUTING files for licensing details.
+//
+
+#include "transaction.hpp"
+
+namespace nr::ue
+{
+namespace ims
+{
+
+EArmResult SipTransactionTable::arm(const std::string &callId, int cseq, const std::string &body)
+{
+    for (auto &e : m_entries)
+    {
+        if (e.callId == callId && e.cseq == cseq)
+        {
+            e.body = body;
+            e.retransmitsLeft = MAX_RETRANSMITS;
+            return EArmResult::REPLACED;
+        }
+    }
+
+    bool evicted = false;
+    if (m_entries.size() >= CAPACITY)
+    {
+        m_entries.erase(m_entries.begin());
+        evicted = true;
+    }
+    m_entries.push_back({callId, cseq, body, MAX_RETRANSMITS});
+    return evicted ? EArmResult::ADDED_WITH_EVICTION : EArmResult::ADDED;
+}
+
+bool SipTransactionTable::cancel(const std::string &callId, int cseq)
+{
+    for (auto it = m_entries.begin(); it != m_entries.end(); ++it)
+    {
+        if (it->callId == callId && it->cseq == cseq)
+        {
+            m_entries.erase(it);
+            return true;
+        }
+    }
+    return false;
+}
+
+void SipTransactionTable::cancelAll()
+{
+    m_entries.clear();
+}
+
+std::vector<std::string> SipTransactionTable::tick()
+{
+    std::vector<std::string> out;
+    for (auto it = m_entries.begin(); it != m_entries.end();)
+    {
+        out.push_back(it->body);
+        it->retransmitsLeft--;
+        if (it->retransmitsLeft <= 0)
+            it = m_entries.erase(it);
+        else
+            ++it;
+    }
+    return out;
+}
+
+bool SipTransactionTable::contains(const std::string &callId, int cseq) const
+{
+    for (const auto &e : m_entries)
+        if (e.callId == callId && e.cseq == cseq)
+            return true;
+    return false;
+}
+
+bool SipTransactionTable::empty() const
+{
+    return m_entries.empty();
+}
+
+std::size_t SipTransactionTable::size() const
+{
+    return m_entries.size();
+}
+
+} // namespace ims
+} // namespace nr::ue
