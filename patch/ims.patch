+void TestPacketChecksums()
+{
+    const std::string payloads[] = {"", "a", "hello", "odd-length-payload-12345"};
+    for (auto &p : payloads)
+    {
+        auto pkt = BuildUdpPacket(p, "192.168.101.3", "172.21.0.21", 5060, 5060);
+        CHECK(static_cast<size_t>(pkt.length()) == 28 + p.size());
+        // IP header checksum: reference computed over the header with the checksum field zeroed.
+        uint8_t ipHdr[20];
+        std::memcpy(ipHdr, pkt.data(), 20);
+        ipHdr[10] = 0;
+        ipHdr[11] = 0;
+        uint16_t refIp = RefChecksum(ipHdr, 20);
+        uint16_t ip = (pkt.data()[10] << 8) | pkt.data()[11];
+        CHECK_EQ(ip, refIp);
+        // UDP checksum (pseudo-header + UDP header + payload)
+        uint16_t refUdp = RefUdpChecksum(pkt);
+        uint16_t udp = (pkt.data()[26] << 8) | pkt.data()[27];
+        CHECK_EQ(udp, refUdp);
+        // round trip: extract the payload back
+        CHECK(ExtractUdpPayload(pkt) == p);
+    }
+}
