+// Strips the ";tag=xxx" suffix (and any display-name) from a header value, keeping the SIP URI.
+std::string StripUriTag(const std::string &header)
+{
+    auto tagPos = header.rfind(";tag=");
+    std::string val = tagPos == std::string::npos ? header : header.substr(0, tagPos);
+    val = val.substr(val.find_last_of('<') + 1);
+    if (!val.empty() && val.back() == '>')
+        val.pop_back();
+    return val;
+}
+
+// Joins a Record-Route list into the comma-separated route set used by in-dialog requests.
+// The callee (UAS) must use the reversed order (its own P-CSCF first).
+std::string JoinRouteSet(const std::vector<std::string> &routes, bool reverse)
+{
+    std::string out;
+    if (reverse)
+    {
+        for (auto it = routes.rbegin(); it != routes.rend(); ++it)
+            out += out.empty() ? *it : "," + *it;
+    }
+    else
+    {
+        for (const auto &r : routes)
+            out += out.empty() ? r : "," + r;
+    }
+    return out;
+}
+
